:host{display:block}.forecast-card{background:#fff;border:1px solid #dce5f1;color:#14263e;padding:16px;border-radius:16px;margin:12px 0}.forecast-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:17px;font-weight:600;flex-wrap:wrap}.forecast-state{font-size:11px;font-weight:400;color:#4d607b;white-space:nowrap}.forecast-types{display:flex;gap:20px;border-bottom:1px solid #dce5f1;margin:12px 0 14px}.forecast-type{margin:0;padding:8px 0;min-height:44px;border-radius:0;background:transparent;color:#4d607b;font-size:13px;font-weight:500;border-bottom:2px solid transparent}.forecast-type::after,.forecast-link::after{border:0}.forecast-type.selected{border-bottom-color:#2458ce;color:#2458ce}.forecast-metrics{display:flex;gap:32px;margin:8px 0 14px}.forecast-metric{flex:1;min-width:0}.forecast-metric-label{color:#4d607b;font-size:12px}.forecast-metric-value{font-size:32px;line-height:1.4;color:#2458ce;font-weight:600}.forecast-message{font-size:15px;line-height:24px}.forecast-meta{font-size:11px;line-height:1.8;color:#4d607b;margin-top:8px}.forecast-link{display:flex;align-items:center;justify-content:space-between;background:transparent;color:#2458ce;border-radius:0;font-size:13px;padding:10px 0 0;margin:8px 0 0;min-height:44px;text-align:left}

.forecast-range{padding:13px 0 15px;border-bottom:1px solid #e2eaf5;margin-bottom:16px}.forecast-range-label{font-size:11px;color:#617b9c;line-height:18px}.forecast-range-value{font-size:17px;font-weight:600;line-height:1.7;color:#2458ce;margin:5px 0;font-variant-numeric:tabular-nums;overflow-wrap:break-word}
