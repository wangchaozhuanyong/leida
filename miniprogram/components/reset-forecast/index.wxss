:host{display:block}.forecast-card{background:#fff;border:1px solid #ccd9ed;border-radius:12px;padding:20px;margin:18px 0 14px;color:#14263e}.forecast-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:17px;font-weight:650}.forecast-state{font-size:11px;font-weight:400;color:#4d607b;white-space:nowrap}.forecast-types{display:flex;gap:20px;border-bottom:1px solid #ccd9ed;margin:12px 0 14px}.forecast-types button{margin:0;padding:8px 0;min-height:44px;border-radius:0;background:transparent;color:#4d607b;font-size:13px;font-weight:500;border-bottom:2px solid transparent}.forecast-types button::after,.forecast-link::after{border:0}.forecast-types button.selected{border-bottom-color:#2458ce;color:#2458ce}.forecast-metrics{display:flex;gap:32px;margin:8px 0 14px}.forecast-metrics>view{flex:1}.forecast-metrics text{color:#4d607b;font-size:12px}.forecast-metrics>view>view{font-size:32px;font-weight:650;line-height:1.4;color:#2458ce}.forecast-message{font-size:13px;line-height:1.8}.forecast-meta{font-size:11px;line-height:1.8;color:#4d607b;margin-top:8px}.forecast-link{display:flex;align-items:center;justify-content:space-between;background:transparent;color:#2458ce;border-radius:0;font-size:13px;padding:10px 0 0;margin:8px 0 0;min-height:44px;text-align:left}

.forecast-range{padding:13px 0 15px;border-bottom:1px solid #e2eaf5;margin-bottom:16px}.forecast-range-label{font-size:11px;color:#617b9c;line-height:18px}.forecast-range-value{font-size:17px;font-weight:600;line-height:1.7;color:#2458ce;margin:5px 0;font-variant-numeric:tabular-nums;overflow-wrap:break-word}
