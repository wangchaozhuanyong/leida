.loading-page{min-height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#f2f5fb;color:#6f8098;font-size:13px}.loading-bar,.loading-label{opacity:0;animation:loading-reveal 0s .2s forwards}.loading-bar{width:160px;height:4px;border-radius:4px;overflow:hidden;background:#dce6f6}.loading-light{width:40%;height:100%;border-radius:4px;background:linear-gradient(90deg,#93c5ff,#3164db);animation:loading-glide 1.8s ease-in-out infinite}@keyframes loading-glide{0%{transform:translateX(-110%)}100%{transform:translateX(360%)}}@keyframes loading-reveal{to{opacity:1}}@media(prefers-reduced-motion:reduce){.loading-light{animation:none;transform:translateX(75%)}.loading-bar,.loading-label{animation:none;opacity:1}}
