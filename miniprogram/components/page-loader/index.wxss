.loading-page{position:fixed;inset:0;z-index:20;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#0b1113;color:#aeb9b3;font-size:15px}.loading-ring{width:26px;height:26px;border:2px solid #34413b;border-top-color:#d9c18d;border-radius:50%;animation:loading-spin 1s linear infinite}@keyframes loading-spin{to{transform:rotate(360deg)}}
