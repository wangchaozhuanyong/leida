:host{display:block}.loading-card{border:1px solid #e2e9f4;background:rgba(255,255,255,.72);margin-bottom:12px;padding:16px;border-radius:16px}.bone{height:12px;border-radius:6px;margin:12px 0;background:#e4ebf5}.bone.short{width:43%}.bone.heading{width:77%;height:20px;margin:18px 0}.bone.tail{width:65%}.loading-paragraph{margin:34px 0}.loading-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin:22px 0}.loading-day{aspect-ratio:1;border-radius:8px;background:#edf2fa}.loading-tabs{display:flex;gap:8px;padding:4px;background:rgba(255,255,255,.6);border:1px solid #fff;border-radius:12px;height:56px}.loading-pill{flex:1;border-radius:8px;background:#e3ecfa}.loading-pill.alt{background:#ede8f8}.variant-home{min-height:0;padding:0}.loading-orbit{position:relative;width:calc(100% + 32px);margin:0 -16px;aspect-ratio:1;display:flex;align-items:center;justify-content:center}.loading-orbit-art{position:absolute;width:100%;height:100%;opacity:.6}.loading-orbit-copy{width:34%;position:relative}.loading-orbit-copy .bone{margin:15px auto}.loading-orbit-copy .metric{height:34px;width:80%}.loading-copy{margin:-4px 0 17px;padding:0 7px;height:60px}.loading-copy .bone{margin:10px auto;width:84%}.loading-copy .bone.short{width:62%}.loading-fact{padding:12px 18px;border:1px solid #e6eef9;border-radius:16px;background:rgba(255,255,255,.7);min-height:78px}.loading-fact .bone{margin:7px 0;width:70%}.loading-fact.compact{margin-top:8px;min-height:60px}.loading-tabs.actions{height:48px;margin:14px 0 24px;border:0;border-radius:8px;padding:0;background:none;gap:10px}.loading-tabs.actions .loading-pill{border-radius:8px}.loading-hint{position:absolute;left:0;right:0;bottom:0;text-align:center;font-size:11px;opacity:0;animation:hint-reveal .3s 1.2s forwards}.bone,.loading-day,.loading-pill{animation:bone-breathe 1.8s ease-in-out infinite}@keyframes bone-breathe{0%,100%{opacity:.58}50%{opacity:1}}@keyframes hint-reveal{to{opacity:1}}@media(prefers-reduced-motion:reduce){.bone,.loading-day,.loading-pill{animation:none}.loading-hint{animation:none;opacity:1}}
.loading-page.is-inset{padding:0}.home-placeholder{padding-top:0}

.loading-page{position:relative;min-height:300px;color:#7c8da5;pointer-events:none;padding:12px 16px;opacity:0;transition:opacity .16s ease-out;padding:12px 16px}.loading-page.is-visible{opacity:1}@media(prefers-reduced-motion:reduce){.loading-page{transition:none}}
