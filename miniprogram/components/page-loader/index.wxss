.loading-page{min-height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#f2f5fb;color:#4d607b;font-size:15px}.loading-ring,.loading-label{opacity:0;animation:loading-reveal 0s .2s forwards}.loading-page .loading-ring{width:26px;height:26px;border:2px solid #ccd9ed;border-top-color:#2458ce;border-radius:50%;animation:loading-reveal 0s .2s forwards,loading-spin 1s linear infinite}@keyframes loading-spin{to{transform:rotate(360deg)}}@keyframes loading-reveal{to{opacity:1}}

@media(prefers-reduced-motion:reduce){.loading-page .loading-ring,.loading-label{animation:none;opacity:1}}
