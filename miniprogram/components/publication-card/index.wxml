<view class="card publication-card">
  <view class="row wrap"><text class="badge {{item.tone}}">{{item.historical ? '历史收录 · ' : ''}}{{item.label}}</text><text class="time">{{item.time}}</text></view>
  <view class="announcement-title">{{item.title}}</view><view class="prose publication-summary">{{item.summary}}</view>
  <view wx:if="{{item.reviewStatus}}" class="publication-context"><text class="context-label">{{item.reviewStatus === "pending" ? "待确认" : "定向跟踪"}}</text><view>{{item.reviewReasons}}</view></view>
  <view class="row publication-footer"><view class="small muted grow">{{item.note}}</view><button class="text-button" bindtap="open">查看详情 →</button></view>
</view>
