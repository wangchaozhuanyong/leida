.instrument{width:100%;max-width:380px;margin:0 auto}.face{width:100%;padding-top:100%;position:relative;background:radial-gradient(circle,#e0eafb 0%,#e0eafb 48%,#fff 48.3%,#fff 59%,transparent 60%)}.canvas{position:absolute;inset:0;width:100%;height:100%}.readout{position:absolute;top:28%;left:20%;right:20%;bottom:28%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}.lead-label{font-size:25rpx;color:#536d91;line-height:1.5}.digits{font-size:40rpx;font-weight:600;line-height:1.45;letter-spacing:0;color:#2458ce;font-variant-numeric:tabular-nums;word-break:break-word}.digits.long{font-size:36rpx}.state{font-size:40rpx;color:#18335c;line-height:1.4;word-break:break-word}.note{font-size:18rpx;color:#73839a;line-height:1.5;margin-top:12rpx}.caption{text-align:center;font-size:10px;color:#73839a;line-height:1.8;margin-top:6px}
.elapsed-group{width:100%;font-variant-numeric:tabular-nums}.days{height:48rpx;display:flex;align-items:center;justify-content:center;gap:6rpx;font-size:30rpx;color:#536d91}.elapsed{display:flex;justify-content:center;gap:8rpx;font-size:58rpx;font-weight:600;line-height:1.15;letter-spacing:-1px;color:#18335c;white-space:nowrap;width:100%}.duration{flex:1;min-width:0;display:flex;align-items:baseline;justify-content:center;gap:3rpx}.unit{font-size:17rpx;font-weight:400;letter-spacing:0;color:#73839a}.seconds .duration-value{color:#2458ce}
