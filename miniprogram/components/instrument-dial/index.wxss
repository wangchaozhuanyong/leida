.instrument{width:100%;max-width:420px;margin:0 auto 24px}.face{width:100%;padding-top:100%;position:relative;background:radial-gradient(circle,#1b241f 0%,#0b1113 68%)}.canvas{position:absolute;inset:0;width:100%;height:100%}.readout{position:absolute;top:28%;left:20%;right:20%;bottom:28%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;pointer-events:none}.lead-label{font-size:14px;color:#b4bdb7;line-height:1.5}.digits{font-size:112rpx;font-weight:600;line-height:1.25;letter-spacing:-2px;color:#f6c660;font-variant-numeric:tabular-nums;white-space:nowrap}.digits.long{font-size:84rpx}.state{font-size:60rpx;color:#f6c660;line-height:1.6;letter-spacing:2px;white-space:nowrap}.note{font-size:11px;color:#8f9b9b;line-height:1.6;margin-top:4px}.caption{text-align:center;font-size:10px;letter-spacing:1px;color:#7e8b90;line-height:1.8}
.elapsed{display:flex;align-items:flex-start;justify-content:center;gap:12rpx;font-size:60rpx;font-weight:600;line-height:1.1;letter-spacing:-1px;color:#2458ce;white-space:nowrap;margin:12rpx 0;width:100%}.elapsed.long{font-size:48rpx}.duration{display:flex;flex-direction:column;align-items:center;gap:8rpx}.unit{font-size:12px;font-weight:500;letter-spacing:0;color:#d7bc86}
