<view class="navigation-space" style="height:{{totalHeight}}px" aria-hidden="true"></view>
<view class="navigation-header" style="padding-top:{{statusBarHeight}}px">
  <view class="navigation-inner {{back ? 'has-back' : ''}}" style="height:{{barHeight}}px;padding-right:{{rightInset}}px">
    <button wx:if="{{back}}" class="navigation-back" bindtap="goBack" hover-class="navigation-pressed" aria-label="返回上一页，直接打开时返回首页"><view class="back-mark"></view></button>
    <image wx:if="{{brand}}" class="navigation-logo" src="/assets/icons/brand.png" mode="aspectFit" aria-hidden="true" />
    <image wx:else class="navigation-symbol" src="/assets/icons/{{icon}}.png" mode="aspectFit" aria-hidden="true" />
    <view class="navigation-copy">
      <view class="navigation-title">{{title}}</view>
      <view wx:if="{{refreshState || refreshing}}" class="navigation-feedback {{refreshState === 'error' ? 'is-error' : ''}}" role="status" aria-live="polite">
        <view wx:if="{{refreshState === 'loading' || !refreshState && refreshing}}" class="feedback-spinner" aria-hidden="true" />
        <text wx:else class="feedback-result" aria-hidden="true">{{refreshState === 'error' ? '!' : '✓'}}</text>
        <text class="feedback-message">{{refreshState === 'error' ? '更新失败' : refreshState === 'success' ? '已更新' : '正在更新'}}</text>
      </view>
    </view>
  </view>
</view>
