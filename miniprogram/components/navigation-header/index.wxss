:host{display:block;flex:none}
.navigation-space,.navigation-header,.navigation-inner,.navigation-copy,.navigation-back{box-sizing:border-box}
.navigation-header{position:fixed;z-index:30;top:0;left:0;right:0;background:#f2f5fb;color:#14263e}
.navigation-inner{display:flex;align-items:center;min-width:0;padding-left:16px;gap:8px}
.navigation-logo{flex:none;width:32px;height:32px;margin-left:0;margin-right:0}
.navigation-symbol{width:32px;height:32px;flex:none}
.navigation-copy{min-width:0;flex:1;text-align:left}
.navigation-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:24px;font-size:17px;font-weight:600}
.navigation-inner.has-back{padding-left:8px;gap:8px}
.navigation-back{width:44px;height:44px;min-height:44px;flex:none;display:flex;align-items:center;justify-content:center;margin:0;padding:0;border:0;border-radius:8px;background:transparent}
.navigation-back::after{border:0}
.back-mark{width:10px;height:10px;border-left:2px solid #14263e;border-bottom:2px solid #14263e;transform:rotate(45deg);margin-left:4px}
.navigation-pressed{background:#e8eef8}
.navigation-feedback{box-sizing:border-box;display:flex;align-items:center;gap:6px;height:16px;min-width:0;color:#2458ce;font-size:12px;line-height:16px;pointer-events:none}
.feedback-message{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.feedback-spinner{box-sizing:border-box;width:14px;height:14px;flex:none;border:2px solid #d7e5ff;border-top-color:#2458ce;border-right-color:#2458ce;border-radius:50%;animation:feedback-spin .8s linear infinite}
.feedback-result{font-size:13px;line-height:16px;font-weight:600;flex:none}
.navigation-feedback.is-error{color:#8a541a}
@keyframes feedback-spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.feedback-spinner{animation:none}}
