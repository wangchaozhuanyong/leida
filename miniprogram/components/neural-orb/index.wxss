:host{display:block;width:100%;height:100%}
.neural-art{position:relative;width:100%;height:100%;pointer-events:none}
.neural-static,.neural-canvas{position:absolute;left:0;top:0;width:100%;height:100%}
.radar-face{position:absolute;left:7.6%;top:7.6%;width:84.8%;height:84.8%;box-sizing:border-box;border:1px solid #4370b761;border-radius:50%;background:#eef6ffb3;overflow:hidden}
.radar-ring{position:absolute;box-sizing:border-box;border:1px solid #436eb833;border-radius:50%}
.radar-ring.middle{width:66%;height:66%;left:17%;top:17%}.radar-ring.inner{width:33%;height:33%;left:33.5%;top:33.5%}
.radar-axis{position:absolute;background:#436eb829}.radar-axis.horizontal{left:3%;top:50%;width:94%;height:1px}.radar-axis.vertical{top:3%;left:50%;height:94%;width:1px}
.radar-sweep{position:absolute;left:50%;top:50%;width:50%;height:1px;background:#2c74d1bf;transform-origin:left center;transform:rotate(-6deg)}
.radar-point{position:absolute;width:3px;height:3px;margin:-1.5px;border-radius:50%;background:#3171beba;box-shadow:0 0 0 3px #4291d71a}
.radar-point.first{left:64.2%;top:25.3%}.radar-point.second{left:81%;top:73.6%}.radar-point.third{left:31.3%;top:62.5%}
.radar-center{position:absolute;left:50%;top:50%;width:3px;height:3px;margin:-2.5px;border:1px solid #fff;border-radius:50%;background:#3c76be}
.radar-marker{position:absolute;background:#436eb885}.radar-marker.north,.radar-marker.south{left:50%;width:1px;height:4px}.radar-marker.north{top:2%}.radar-marker.south{bottom:2%}.radar-marker.east,.radar-marker.west{top:50%;height:1px;width:4px}.radar-marker.east{right:2%}.radar-marker.west{left:2%}
.neural-canvas{visibility:hidden}
.is-ready .neural-canvas{visibility:visible}
.is-ready .neural-static{visibility:hidden}
/* Unsupported preference queries leave the ornament static. */
.motion-preference{position:absolute;left:0;top:0;width:0;height:1px;visibility:hidden;pointer-events:none}
@media(prefers-reduced-motion:no-preference){.motion-preference{width:1px}}
@media(prefers-reduced-motion:reduce){.is-ready .neural-canvas{visibility:hidden}.is-ready .neural-static{visibility:visible}}

/* Static sphere remains legible when animation/canvas is unavailable. */
.sphere-face{position:absolute;left:50%;top:50%;width:224px;max-width:81%;height:224px;max-height:100%;transform:translate(-50%,-50%);border:1px solid #7ea5d52e;border-radius:50%;background:radial-gradient(ellipse,#edf5ff00 52%,#dcecff20 84%,#edf5ff00)}
.sphere-meridian,.sphere-latitude{position:absolute;border:1px solid #7ea5d52e;border-radius:50%}
.sphere-meridian{top:0;height:100%;width:52%;left:24%;transform:rotate(24deg)}.sphere-meridian.second{transform:rotate(-28deg)}
.sphere-latitude{left:0;width:100%;height:45%;top:27.5%;transform:rotate(16deg)}.sphere-latitude.second{transform:rotate(-32deg)}
.sphere-node{position:absolute;width:4px;height:4px;border-radius:50%;background:#4286e8aa;box-shadow:0 0 0 4px #4b92f70a}
.sphere-node.first{left:14%;top:22%}.sphere-node.second{right:9%;bottom:30%}.sphere-node.third{left:39%;bottom:3%}
