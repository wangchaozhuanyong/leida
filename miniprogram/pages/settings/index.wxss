.inbox-card{padding-bottom:10px}.inbox-card>.row{margin-bottom:8px}.inbox-card .text-button{justify-content:flex-end;white-space:nowrap;font-size:11px}.inbox-unread{font-size:11px;font-weight:400;color:#2458ce;margin-left:6px}.inbox-preview{width:100%;padding:14px 0;min-height:72px;background:none;text-align:left;align-items:flex-start;justify-content:flex-start;border-radius:0;border-top:1px solid #ccd9ed;font-size:14px;font-weight:500;line-height:1.65}.inbox-preview .dot{margin-top:9px;flex:none}.inbox-summary{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:12px;color:#4d607b;margin:4px 0}.inbox-empty{padding:20px 0 16px;color:#4d607b;font-size:13px}
.reminder-count{display:flex;align-items:baseline;gap:8px;margin-top:20px}.reminder-number{font-size:38px;line-height:1.2;color:#2458ce;font-weight:600;font-variant-numeric:tabular-nums}.reminder-add{margin-top:20px}.reminder-close{margin-top:12px}
.reminder-types{margin-top:22px}.reminder-types-heading{font-size:13px;font-weight:600;padding-bottom:4px}.reminder-types-heading .small{font-weight:400;min-height:20px}.reminder-type-row{display:flex;align-items:center;gap:12px;min-height:80px;padding:14px 0;border-bottom:1px solid #ccd9ed}.reminder-type-row .grow>view:first-child{font-size:15px;font-weight:600;margin-bottom:3px}.reminder-type-row switch{padding:6px 0 6px 8px;flex:none}.reminder-paused{padding:12px 14px;border-radius:8px;background:#e8eef8;color:#355a86;font-size:13px;margin-top:14px}

.reminder-number{display:inline-block;min-width:2.6ch;text-align:center}.reminder-feedback{min-height:24px;line-height:24px;margin-top:12px;font-size:12px}.reminder-help{min-height:22px}.inbox-loading{min-height:72px;display:flex;align-items:center;justify-content:space-between;color:#6e7f97;font-size:13px}.reminder-add,.reminder-close{min-height:46px}
.reminder-card .reminder-add.is-disabled,.reminder-card .reminder-close.is-disabled{opacity:1;color:#4d607b;background:#e8eef8;border-color:#ccd9ed}
.reminder-card .reminder-add.is-pending{color:#fff;background:linear-gradient(115deg,#1d45a3,#2458ce);border-color:#2458ce}
.reminder-card .reminder-close.is-pending{color:#2458ce;background:#e8eef8;border-color:#91aaca}

.reminder-skeleton{min-height:470px}.reminder-skeleton-count{width:100px;height:42px;background:#e8eef8;border-radius:8px;margin:22px 0 30px}.reminder-skeleton-line{height:65px;background:#eef3fa;border-radius:10px;margin:15px 0}.reminder-skeleton-button{height:46px;background:#e8eef8;border-radius:10px;margin-top:26px}

.support-card{display:flex;align-items:center;gap:12px;min-height:88px;width:100%;margin:0 0 18px;padding:17px 16px;background:linear-gradient(115deg,#e7f2ff,#f0edff);border:1px solid #d5e4f8;border-radius:18px;text-align:left;line-height:1.5;white-space:normal}.support-card::after{border:0}.support-icon{display:flex;align-items:center;justify-content:center;width:40px;height:40px;flex:none;border-radius:14px;background:#fff;color:#376ed5;font-size:24px;font-weight:650;box-shadow:0 3px 10px #5c88ce12}.support-copy{flex:1;min-width:0}.support-title{font-size:16px;font-weight:650;color:#294b7a}.support-caption{font-size:11px;color:#6f819b;margin-top:4px}.support-arrow{color:#467bd0;font-size:21px;flex:none}.support-card:active{background:#e4edfc}

.support-icon image{width:28px;height:28px}
