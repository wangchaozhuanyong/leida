.inbox-card{padding-bottom:10px}.inbox-card>.row{margin-bottom:8px}.inbox-card .text-button{justify-content:flex-end;white-space:nowrap;font-size:12px}.inbox-unread{font-size:11px;font-weight:400;color:#2458ce;margin-left:6px}.inbox-preview{width:100%;padding:14px 0;min-height:72px;background:none;text-align:left;align-items:flex-start;justify-content:flex-start;border-radius:0;border-top:1px solid #dce5f1;font-size:14px;font-weight:500;line-height:1.65}.inbox-preview .dot{margin-top:9px;flex:none}.inbox-summary{overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;font-size:12px;color:#4d607b;margin:4px 0}.inbox-empty{padding:20px 0 16px;color:#4d607b;font-size:13px}
.reminder-count{display:flex;align-items:baseline;gap:8px;margin-top:16px}.reminder-add{margin-top:16px}.reminder-close{margin-top:12px}
.reminder-types{margin-top:24px}.reminder-types-heading{font-weight:600;padding-bottom:4px;font-size:14px}.reminder-types-heading .small{font-weight:400;min-height:20px}.reminder-type-row{display:flex;align-items:center;gap:12px;min-height:80px;border-bottom:1px solid #dce5f1;padding:16px 0}.reminder-type-row .grow>view:first-child{font-size:15px;font-weight:600;margin-bottom:3px}.reminder-type-row switch{padding:6px 0 6px 8px;flex:none}.reminder-paused{padding:12px 14px;border-radius:8px;background:#e8eef8;color:#355a86;font-size:13px;margin-top:14px}

.reminder-number{color:#2458ce;font-weight:600;font-variant-numeric:tabular-nums;font-size:40px;line-height:44px;display:inline-block;min-width:2.6ch;text-align:center;font-size:40px;line-height:44px}.reminder-feedback{margin-top:12px;font-size:12px;min-height:0;line-height:18px}.reminder-help{min-height:0}.inbox-loading{min-height:72px;display:flex;align-items:center;justify-content:space-between;color:#6e7f97;font-size:13px}.reminder-add,.reminder-close{min-height:46px}
.reminder-card .reminder-add.is-disabled,.reminder-card .reminder-close.is-disabled{opacity:1;color:#4d607b;background:#e8eef8;border-color:#dce5f1}
.reminder-card .reminder-add.is-pending{color:#fff;background:linear-gradient(115deg,#1d45a3,#2458ce);border-color:#2458ce}
.reminder-card .reminder-close.is-pending{color:#2458ce;background:#e8eef8;border-color:#91aaca}

.support-card{display:flex;align-items:center;gap:12px;min-height:88px;width:100%;background:linear-gradient(115deg,#e7f2ff,#f0edff);border:1px solid #d5e4f8;text-align:left;line-height:1.5;white-space:normal;margin:0 0 12px;padding:16px;border-radius:16px}.support-card::after{border:0}.support-icon{display:flex;align-items:center;justify-content:center;width:40px;height:40px;flex:none;background:#fff;color:#376ed5;font-size:24px;box-shadow:0 3px 10px #5c88ce12;font-weight:600;border-radius:12px}.support-copy{flex:1;min-width:0}.support-title{color:#294b7a;font-size:17px;font-weight:600}.support-caption{margin-top:4px;font-size:12px;color:#4d607b}.support-arrow{color:#467bd0;font-size:21px;flex:none}.support-card:active{background:#e4edfc}

.support-icon image{width:28px;height:28px}

.inbox-pin{color:#2458ce;font-size:12px;font-weight:600}

/* Only an unresolved first entry waits. Existing content never returns here. */
.reminder-entry-wait{height:128px;display:flex;align-items:center;justify-content:center;gap:6px}
.reminder-entry-wait>view{width:5px;height:5px;border-radius:50%;background:#5578af;animation:reminder-entry-pulse .9s ease-in-out infinite}
.reminder-entry-wait>view:nth-child(2){animation-delay:.15s}.reminder-entry-wait>view:nth-child(3){animation-delay:.3s}
@keyframes reminder-entry-pulse{0%,80%,100%{opacity:.35;transform:scale(.8)}40%{opacity:1;transform:scale(1.15)}}
@media(prefers-reduced-motion:reduce){.reminder-entry-wait>view{animation:none;opacity:.65}}
