.poster-page{padding:14px 20px 24px}.poster-style-options{display:flex;gap:10px;margin-bottom:14px}.poster-style-options button{flex:1;min-width:0;background:#121d1b;border:1px solid #35443b;font-size:13px;gap:8px;min-height:46px}.poster-style-options .selected{border-color:#d9c18d;color:#ecd6a9;background:#24261e}.style-dot{width:14px;height:18px;border:1px solid #a19265;border-radius:2px;flex:none}.style-dot.dark{background:#101311}.style-dot.light{background:#f1e6d1}.poster-stage{height:calc(100vh - 240px);min-height:300px;max-height:680px;display:flex;align-items:center;justify-content:center;background:#111a18;border:1px solid #2c3b32;border-radius:8px;overflow:hidden}.poster-image{width:100%;height:100%}.poster-message{padding:24px;text-align:center;color:#b5c0b6;font-size:14px}.poster-actions{margin-top:16px}.poster-actions button{min-height:48px}.poster-note{margin-top:10px;line-height:1.65}

.poster-stage{position:relative}.poster-busy{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#0b1113d9}
