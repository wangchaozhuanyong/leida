<page-loader wx:if="{{navigationLoading}}" />
<view wx:else>
<view class="page">
  <view wx:if="{{sceneLoading}}" class="card empty">正在读取小程序码对应的发布版本。</view>
  <view wx:if="{{sceneError}}" class="warning">{{sceneError}}<button wx:if="{{sceneCanRetry}}" class="secondary full" style="margin-top:12px" bindtap="retryScene">重新读取</button><button class="secondary full" style="margin-top:12px" data-path="/pages/announcements/index" bindtap="navigate">查看公开公告</button></view>
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:elif="{{detail}}">
    <view wx:if="{{error}}" class="warning">{{error}}<button class="secondary" bindtap="retry">重新加载</button></view>
    <view wx:if="{{detail.missing}}" class="card empty"><view class="heading">{{detail.title}}</view><view>{{detail.explanation}}</view><button class="secondary full" style="margin-top:16px" data-path="/pages/announcements/index" bindtap="navigate">返回公开公告</button></view>
    <block wx:else>
      <view wx:if="{{detail.withdrawn}}" class="warning">这条内容已撤回，以下保留原发布版本，不能作为当前发放依据。</view>
      <view wx:if="{{detail.merged}}" class="warning">此事件已合并，以下为原发布版本。<button wx:if="{{detail.mergePath}}" class="secondary full" style="margin-top:12px" data-path="{{detail.mergePath}}" bindtap="navigate">查看合并后的事件</button><view wx:else>合并目标暂时缺少公开记录。</view></view>
      <view wx:if="{{detail.isOld}}" class="warning">正在查看指定历史版本。<button wx:if="{{detail.latestPath}}" class="secondary full" style="margin-top:12px" data-path="{{detail.latestPath}}" bindtap="navigate">查看最新公开版本</button></view>
      <view wx:if="{{detail.reviewStatus}}" class="warning">{{detail.reviewStatus === 'pending' ? '待确认' : '定向异常跟踪'}}：{{detail.reviewReasons}}</view>
      <view class="title">{{detail.title}}</view><view class="muted lead" style="margin-bottom:18px">{{detail.historical ? '历史收录 · ' : ''}}{{detail.time}} · 第{{detail.version}}版</view>
      <view class="card"><view class="heading">中文摘要</view><view class="prose">{{detail.summary}}</view><view wx:if="{{detail.newsOnly}}" class="warning" style="margin-top:16px;margin-bottom:0">仅收录来源消息，不改变福利状态、次数和发放提醒。</view></view>
      <view class="card"><button class="disclosure-heading" data-section="bodyOpen" bindtap="toggleSection" aria-expanded="{{bodyOpen}}"><text>完整内容</text><text class="disclosure-symbol">{{bodyOpen ? '−' : '+'}}</text></button><text wx:if="{{bodyOpen}}" class="prose" style="display:block" user-select="{{true}}">{{detail.body}}</text></view>
      <view wx:if="{{!detail.newsOnly}}" class="card"><view class="heading">福利动作</view>
        <view wx:for="{{detail.actions}}" wx:key="id" class="fact"><view class="row wrap"><text class="badge">{{item.label}}</text><text>{{item.stage}}</text></view><view class="lead">资格：{{item.eligibility}}</view><view class="muted">范围：{{item.scope}}</view><view class="muted">预计时间：{{item.expectedAt}}</view><view wx:if="{{item.quote}}" class="quote">{{item.quote}}</view></view>
        <view wx:if="{{!detail.actions.length}}" class="muted lead">此版本没有已发布的福利动作。</view><view class="small muted lead">依据公开声明，个人账户是否到账尚未观测。</view>
      </view>
      <button class="disclosure-heading section" data-section="evidenceOpen" bindtap="toggleSection" aria-expanded="{{evidenceOpen}}"><text>原文与证据</text><text class="disclosure-symbol">{{evidenceOpen ? '−' : '+'}}</text></button><block wx:if="{{evidenceOpen}}">
      <view wx:for="{{detail.evidence}}" wx:key="id" class="card"><view class="row wrap"><text class="badge {{item.label === '辅助归档' ? 'purple' : ''}}">{{item.label}}</text><text class="small muted">{{item.time}}</text></view><view class="small muted lead">{{item.origin}}</view><view wx:if="{{!item.complete}}" class="warning" style="margin-top:12px">保存的正文或上下文不完整。</view>
        <view wx:if="{{item.title}}" class="muted lead">附加标题：{{item.title}}</view><view wx:if="{{item.description}}" class="muted lead">附加摘要：{{item.description}}</view><view wx:if="{{item.title || item.description}}" class="small muted lead">附加信息不冒充原帖正文。</view>
        <text class="source-text quote" style="display:block" user-select="{{true}}">{{item.text}}</text><view class="small muted">本站采集：{{item.collectedAt}}</view><button wx:if="{{item.url}}" class="secondary full" style="margin-top:14px" data-url="{{item.url}}" bindtap="copySource">复制原始来源链接</button>
      </view><view wx:if="{{!detail.evidence.length}}" class="card muted">暂未提供可展示的原文。</view>
      </block><view class="card"><button class="disclosure-heading" data-section="recordOpen" bindtap="toggleSection" aria-expanded="{{recordOpen}}"><text>记录信息</text><text class="disclosure-symbol">{{recordOpen ? '−' : '+'}}</text></button><view wx:if="{{recordOpen}}"><view class="fact record-row"><view class="muted">资料截止</view><view>{{detail.cutoff}}</view></view><view class="fact record-row"><view class="muted">本站发布</view><view>{{detail.publishedAt}}</view></view><view class="fact record-row"><view class="muted">版本说明</view><view>{{detail.reason}}</view></view></view></view>
      <view wx:if="{{detail.canShare}}" class="detail-share">
        <view class="share-heading">分享这条公告</view>
        <view class="share-description">选一款长图，把这条公告分享给朋友。</view>
        <view class="announcement-themes" role="group" aria-label="公告长图样式">
          <button class="announcement-theme {{posterTheme === 'precision' ? 'is-selected' : ''}}" data-theme="precision" bindtap="selectPosterTheme" disabled="{{posterBusy || posterSaving}}" aria-pressed="{{posterTheme === 'precision'}}" aria-label="黑金长图{{posterTheme === 'precision' ? '，已选中' : ''}}">
            <view class="theme-swatch theme-swatch-dark" aria-hidden="true"><view class="swatch-rule"/><view class="swatch-title"/><view class="swatch-line"/><view class="swatch-line short"/></view>
            <view class="theme-copy"><view class="theme-name">黑金</view><view class="theme-caption">沉静醒目</view></view><view class="theme-check" aria-hidden="true">{{posterTheme === 'precision' ? '✓' : ''}}</view>
          </button>
          <button class="announcement-theme {{posterTheme === 'editorial' ? 'is-selected' : ''}}" data-theme="editorial" bindtap="selectPosterTheme" disabled="{{posterBusy || posterSaving}}" aria-pressed="{{posterTheme === 'editorial'}}" aria-label="米白长图{{posterTheme === 'editorial' ? '，已选中' : ''}}">
            <view class="theme-swatch theme-swatch-light" aria-hidden="true"><view class="swatch-rule"/><view class="swatch-title"/><view class="swatch-line"/><view class="swatch-line short"/></view>
            <view class="theme-copy"><view class="theme-name">米白</view><view class="theme-caption">清晰耐读</view></view><view class="theme-check" aria-hidden="true">{{posterTheme === 'editorial' ? '✓' : ''}}</view>
          </button>
        </view>
        <view class="announcement-share-actions"><button class="share-friend" open-type="share">发给朋友</button><button class="share-generate" loading="{{posterBusy}}" disabled="{{posterBusy || posterSaving}}" bindtap="generatePoster">{{posterBusy ? '生成中' : posterPreview ? '更新长图' : '生成长图'}}</button></view>
        <view wx:if="{{posterError}}" class="warning share-error" role="alert">{{posterError}}<button wx:if="{{!posterBusy}}" class="text-button" bindtap="generatePoster">重新生成 →</button></view>
        <view wx:if="{{posterPreview}}" class="announcement-preview">
          <view class="preview-heading"><text>长图预览</text><button class="text-button preview-expand" bindtap="previewPoster" disabled="{{posterBusy}}">查看大图 ↗</button></view>
          <view class="announcement-poster-stage"><image src="{{posterPreview}}" mode="aspectFit" class="announcement-poster-image" bindtap="previewPoster" aria-label="公告长图，点击查看完整图片"/><view wx:if="{{posterBusy}}" class="poster-progress" role="status">正在生成{{posterTheme === 'precision' ? '黑金' : '米白'}}长图</view></view>
          <button class="share-save" loading="{{posterSaving}}" disabled="{{posterSaving || posterBusy || !posterReady}}" bindtap="savePoster">保存长图到相册</button>
          <view class="share-description preview-note">内容对应当前公告版本，点击图片可放大阅读。</view>
        </view>
      </view>
      <view wx:if="{{posterPrivacyNeeded}}" class="card stack"><button class="secondary full" bindtap="openPrivacyContract">阅读微信隐私指引</button><button class="primary full" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePosterPrivacy">同意并继续保存</button></view>
      <canvas type="2d" id="poster-canvas" style="position:fixed;left:-9999px;top:0;width:900px;height:2400px"/>
      <view class="foot">时间均为北京时间</view>
    </block>
  </block>
</view>

</view>
