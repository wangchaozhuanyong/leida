/* 原文使用纯文本，避免执行来源内容。 */
.detail-share{margin-top:28px;padding:24px 0 8px;border-top:1px solid #ccd9ed}
.share-header{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.share-heading{flex:none;font-size:19px;font-weight:600;line-height:1.5;color:#14263e}
.share-subtitle{margin-left:auto;font-size:12px;line-height:1.5;color:#4d607b;text-align:right;white-space:nowrap}
.share-description{margin-top:6px;font-size:12px;line-height:1.8;color:#4d607b}
.announcement-themes{display:flex;gap:10px;margin:18px 0 16px}
.detail-share .announcement-theme{flex:1;min-width:0;min-height:78px;gap:10px;padding:13px 12px;justify-content:flex-start;text-align:left;background:#ffffff;border:1px solid #ccd9ed;border-radius:12px;color:#14263e;font-weight:400}
.detail-share .announcement-theme.is-selected{border-color:#2458ce;background:#e8effa}
.detail-share .announcement-theme[disabled]{opacity:.65;color:#14263e}
.theme-copy{min-width:0;flex:1}.theme-name{font-size:14px;font-weight:600;line-height:1.5}.theme-caption{font-size:10px;line-height:1.6;color:#4d607b;margin-top:3px}
.theme-swatch{width:27px;height:38px;padding:6px 4px;flex:none;border-radius:2px;border:1px solid #756849;background:#0b1113;color:#dbc28a}
.theme-swatch-light{background:#f6f0e5;border-color:#d0c5b1;color:#6b6556}
.swatch-rule{height:1px;width:7px;background:currentColor;margin-bottom:5px}.swatch-title{height:3px;background:currentColor;margin-bottom:5px}.swatch-line{height:1px;background:currentColor;margin-bottom:3px;opacity:.65}.swatch-line.short{width:70%}
.theme-check{flex:none;width:16px;height:16px;border:1px solid #91aaca;border-radius:50%;font-size:11px;line-height:14px;text-align:center;color:transparent}
.is-selected .theme-check{background:#2458ce;border-color:#2458ce;color:#ffffff}
.announcement-share-actions{display:flex;gap:10px}.announcement-share-actions button{flex:1;min-width:0;min-height:48px;border-radius:10px;font-size:14px;font-weight:600}
.detail-share .share-friend{border:1px solid #91aaca;background:transparent;color:#14263e}
.detail-share .share-generate,.detail-share .share-save{border:1px solid #2458ce;background:#2458ce;color:#ffffff}
.detail-share .share-generate[disabled],.detail-share .share-save[disabled]{background:#e8eef8;border-color:#ccd9ed;color:#4d607b;opacity:.7}
.detail-share button::after{border:0}.detail-share button:not([disabled]):active{opacity:.8}
.share-error{margin:14px 0 0}.share-error .text-button{min-height:36px;color:#765422}
.announcement-preview{margin-top:24px}.preview-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px;font-size:13px;color:#4d607b}
.preview-heading .preview-expand{min-height:36px;color:#2458ce;font-size:12px}
.announcement-poster-stage{position:relative;background:#e8eef8;border-radius:10px;overflow:hidden;padding:14px}
.announcement-poster-image{width:100%;height:420px;max-height:62vh;display:block}
.poster-progress{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#f2f5fbe8;color:#14263e;font-size:13px;padding:20px}
.detail-share .share-save{width:100%;min-height:48px;margin-top:14px;border-radius:10px}
.preview-note{text-align:center;font-size:11px}
@media(max-width:350px){.announcement-themes{gap:8px}.detail-share .announcement-theme{gap:7px;padding:12px 9px}.theme-caption{font-size:10px}.theme-check{width:14px;height:14px;line-height:12px}}

.progress-row{display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;background:none;padding:12px 0;width:100%;font-size:14px;line-height:1.6;font-weight:400}
