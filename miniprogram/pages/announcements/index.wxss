.record-kinds{display:flex;gap:4px;background:#e5ecf7;padding:4px;border-radius:12px;margin-bottom:16px}.record-kinds button{flex:1;min-height:40px;padding:0 4px;font-size:13px;color:#748399;background:transparent;line-height:40px;border-radius:9px;margin:0}.record-kinds button.active{background:#fff;color:#214faf;font-weight:600;box-shadow:0 2px 6px #2c4f7b0a}.record-dot{width:5px;height:5px;background:#2458ce;border-radius:50%;display:inline-block;flex-shrink:0}.record-dot.banked_reset{background:#9876cb;border-radius:1px;transform:rotate(45deg)}.record-kinds .record-dot{margin-right:6px;vertical-align:2px}
/* One continuous sheet, from month choice to the selected day's announcement. */
.records-page{max-width:620px}
.record-sheet{background:#fff;border:1px solid #dce5f1;border-radius:22px;box-shadow:0 8px 30px #284d7910;overflow:hidden}
.month-calendar{padding:16px 16px 12px}
.month-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 2px 10px}
.month-select{font:inherit;font-size:21px;letter-spacing:-.5px;font-weight:700;min-height:44px;max-width:190px;border:0;background:transparent;color:#20344f;padding:0;cursor:pointer}
.month-subtitle{margin:0 0 2px;font-size:11px;color:#8190a3}
.month-controls{display:flex;gap:2px}
.month-controls button{width:44px;height:44px;border:0;border-radius:50%;background:#f2f6fc;color:#526e96;font:inherit;font-size:26px;cursor:pointer}
.month-controls button[disabled]{color:#c7d1df;background:transparent;opacity:1}
.records-page .record-kinds{background:transparent;padding:0;border-radius:0;border-bottom:1px solid #e9eef5;margin:0 0 8px;gap:0}
.records-page .record-kinds button{min-height:46px;position:relative;border-radius:0;font-size:12px;color:#7b899d}
.records-page .record-kinds button.active{background:transparent;box-shadow:none;color:#2458ce}
.records-page .record-kinds button.active:after{content:"";position:absolute;bottom:-1px;left:16%;right:16%;height:2px;background:#2c5dcd;border-radius:2px}
.kind-count{font-size:12px;margin-left:6px;font-variant-numeric:tabular-nums;opacity:.7}
.month-week,.month-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
.month-week{font-size:11px;color:#9aa5b4;text-align:center;margin-bottom:3px}
.month-week text{height:26px;display:grid;place-items:center}
.month-days{gap:2px 0}
.month-days button{height:44px;min-width:0;position:relative;border:1px solid transparent;border-radius:12px;background:transparent;color:#52647d;font:inherit;font-size:14px;cursor:pointer;font-variant-numeric:tabular-nums}
.month-days button[disabled]{color:#b2bed0;background:transparent;opacity:1}
.month-days button.today:not(.selected){border-color:#d8e2f4;color:#45679b}
.month-days button.selected{color:#fff;background:#2c5dcd;box-shadow:0 4px 11px #2758ce25;font-weight:700}
.day-markers{position:absolute;bottom:4px;left:0;right:0;display:flex;justify-content:center;gap:3px}
.month-days .selected .record-dot{background:#fff}
.record-detail{padding:18px 20px 8px;border-top:1px solid #e9eef5;background:#f8faff}
.record-heading{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px}
.record-heading>text:first-child{font-size:16px;margin:0;font-weight:700;letter-spacing:-.2px;color:#20344f}
.record-count{font-size:10px;color:#8897ad}
.date-record{display:flex;align-items:center;gap:12px;text-decoration:none;padding:14px 0;color:#20344f;min-height:76px}
.record-detail .date-record+.date-record{border-top:1px solid #e3eaf5}
.record-seal{display:grid;place-items:center;flex-shrink:0;width:34px;height:34px;border-radius:50%;background:#e9effc;color:#3765c3;font-size:16px}
.record-seal.banked_reset{background:#eee8f7;color:#8965b7}
.record-copy{flex:1;min-width:0}
.record-meta{display:flex;align-items:center;gap:10px;font-size:11px;color:#8493a8}
.record-label{font-size:11px;color:#426bb6}
.record-label.banked_reset{color:#8965b7}
.record-time{font-size:11px;color:#8c99ac}
.record-title{font-size:14px;line-height:1.6;margin:5px 0 0;font-weight:600;overflow-wrap:anywhere}
.record-chevron{font-size:23px;color:#8ca1bd;flex-shrink:0}
.date-empty{padding:18px 0 10px}
.date-empty>view:first-child{font-size:14px;font-weight:550;color:#657890}
.date-empty .small{font-size:12px;line-height:1.7;margin:6px 0 0;color:#8796ab}
.date-empty button{font:inherit;font-size:12px;color:#2458ce;min-height:44px;padding:0;border:0;background:transparent;cursor:pointer}

.record-notes{margin:2px 2px 0;color:#8a98ad;font-size:11px;line-height:1.8}
.record-notes button{display:flex;justify-content:space-between;align-items:center;min-height:44px;line-height:1.8;padding:0;margin:0;border:0;background:transparent;font-size:11px;color:#8a98ad;border-radius:0;text-align:left;font-weight:400}
.record-note-copy{margin:0 0 14px;font-size:11px;line-height:1.8}
.month-select{display:flex;align-items:center;line-height:1.4}
.month-controls button{margin:0;padding:0;line-height:44px}
.month-days button{width:100%;min-height:44px;margin:0;padding:0;line-height:42px;box-sizing:border-box}
.month-days .blank-day{height:44px}
.records-page .record-kinds button{margin:0;padding:0;line-height:46px;border:0}
.records-page .record-kinds button.active:after{width:auto;transform:none;border:0;top:auto}
.day-markers{height:5px}
.date-record{margin:0;width:100%;line-height:1.5;border:0;border-radius:0;background:transparent;text-align:left;font-weight:400;box-sizing:border-box}
.record-seal{display:flex;align-items:center;justify-content:center}
.record-copy{display:block}
.record-label{padding:0;background:transparent}
.date-empty .text-button{margin:0;text-align:left}
.record-sheet button::after{border:0}
@media(max-width:360px){.month-calendar{padding:12px 10px 10px}.month-select{font-size:19px}.record-detail{padding:16px 14px 6px}.records-page .record-kinds .record-dot{margin-right:4px}.kind-count{margin-left:4px}}
