.record-summary{display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:#748399;font-size:11px;margin-bottom:16px}.record-summary>text:first-child{color:#8a98aa}.record-number{font-size:18px;color:#2458ce;font-weight:650}.record-number.banked{color:#8562b3}.record-kinds{display:flex;gap:4px;background:#e5ecf7;padding:4px;border-radius:12px;margin-bottom:16px}.record-kinds button{flex:1;min-height:40px;padding:0 4px;font-size:13px;color:#748399;background:transparent;line-height:40px;border-radius:9px;margin:0}.record-kinds button.active{background:#fff;color:#214faf;font-weight:600;box-shadow:0 2px 6px #2c4f7b0a}.record-dot{width:5px;height:5px;background:#2458ce;border-radius:50%;display:inline-block;flex-shrink:0}.record-dot.banked_reset{background:#9876cb;border-radius:1px;transform:rotate(45deg)}.record-kinds .record-dot{margin-right:6px;vertical-align:2px}.record-period{font-size:11px;color:#8291a6;margin-bottom:14px}.month-calendar{background:#fff;border:1px solid #dbe4f1;border-radius:20px;padding:10px 12px 13px;box-shadow:0 7px 22px #23476b04}.month-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;padding:0}.month-heading button{width:44px;height:44px;line-height:44px;min-height:44px;margin:0;border:0;border-radius:10px;background:transparent;color:#657b9b;font-size:26px;padding:0}.month-heading button[disabled]{opacity:.25}.month-select{display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:650;min-height:44px;color:#233651;padding:0 6px}.month-week,.month-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.month-week{font-size:11px;color:#9aa5b4;text-align:center;margin-bottom:4px}.month-week text{height:24px;line-height:24px}.month-days{grid-gap:2px 0}.month-days button{height:44px;min-height:44px;min-width:0;width:100%;position:relative;border:1px solid transparent;border-radius:12px;background:transparent;color:#536782;font-size:14px;line-height:42px;padding:0;margin:0;box-sizing:border-box}.month-days .blank-day{height:44px}.month-days button[disabled]{color:#c8d0dd}.month-days button.today{border-color:#d8e2f4}.month-days button.selected{color:#fff;background:#2c5dcd;box-shadow:0 4px 11px #2758ce25;font-weight:700}.day-markers{position:absolute;bottom:4px;left:0;right:0;display:flex;justify-content:center;gap:3px;height:5px}.month-days .selected .record-dot{background:#fff}.record-heading{display:flex;justify-content:space-between;align-items:center;margin:20px 0 7px;font-size:17px;font-weight:650}.date-record{padding:12px 0 16px;border-bottom:1px solid #dce4f1}.record-label{font-size:11px;color:#3b66b7;background:#e8effb;border-radius:5px;padding:4px 6px}.record-label.banked_reset{background:#f0eaf8;color:#8661be}.record-time{font-size:11px;color:#8794a8}.record-title{font-size:16px;line-height:1.6;margin:10px 0 3px;font-weight:600}.date-record .text-button{font-size:12px;min-height:44px}.date-empty{padding:20px 10px;text-align:center;border-top:1px solid #dce4f1;font-size:14px;color:#6c7e96;line-height:1.8}.date-empty .small{margin:8px 0}.date-empty .text-button{margin:auto}.record-foot{font-size:11px;color:#8a98ac;line-height:1.8;margin:15px 0}
