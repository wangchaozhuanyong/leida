<view class="page records-page">
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">{{error}}<button class="text-button" bindtap="retry">重新加载</button></view>
    <view class="record-sheet">
      <view class="month-calendar">
        <view class="month-heading">
          <view><picker mode="selector" range="{{months}}" range-key="label" value="{{monthIndex}}" bindchange="selectMonth"><view class="month-select">{{months[monthIndex].label}} ⌄</view></picker><view class="month-subtitle">本月已收录的完成记录</view></view>
          <view class="month-controls"><button aria-label="上个月" disabled="{{monthIndex===months.length-1}}" bindtap="previousMonth">‹</button><button aria-label="下个月" disabled="{{monthIndex===0}}" bindtap="nextMonth">›</button></view>
        </view>
        <view class="record-kinds"><button wx:for="{{kinds}}" wx:key="value" aria-pressed="{{kind===item.value}}" class="{{kind===item.value?'active':''}}" data-value="{{item.value}}" bindtap="selectKind"><view wx:if="{{item.value!=='all'}}" class="record-dot {{item.value}}" />{{item.label}}<text class="kind-count">{{item.value==='all'?automaticCount+bankedCount:item.value==='automatic_reset'?automaticCount:bankedCount}}</text></button></view>
        <view class="month-week"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view class="month-days"><block wx:for="{{days}}" wx:key="date"><view wx:if="{{item.blank}}" class="blank-day" /><button wx:else class="{{item.selected?'selected':''}} {{item.today?'today':''}}" disabled="{{item.disabled}}" aria-label="{{item.date}}，{{item.count}}条已收录完成记录" aria-pressed="{{item.selected}}" data-date="{{item.date}}" bindtap="selectDay"><text>{{item.day}}</text><view class="day-markers"><view wx:if="{{item.automatic}}" class="record-dot automatic_reset"/><view wx:if="{{item.banked}}" class="record-dot banked_reset"/></view></button></block></view>
      </view>
      <view class="record-detail">
        <view class="record-heading"><text>{{selectedLabel}}</text><text class="record-count">{{selectedItems.length}} 条记录 · 北京时间</text></view>
        <button wx:for="{{selectedItems}}" wx:key="id" class="date-record" aria-label="{{item.title}}，{{item.time}}，查看公告" data-path="{{item.path}}" bindtap="navigate"><text class="record-seal {{item.kind}}" aria-hidden="true">✓</text><view class="record-copy"><view class="record-meta"><text class="record-label {{item.kind}}">{{item.label}}</text><text class="record-time">{{item.time}}</text></view><view class="record-title">{{item.title}}</view></view><text class="record-chevron" aria-hidden="true">›</text></button>
        <view wx:if="{{!selectedItems.length}}" class="date-empty"><view>这一天暂无已收录记录</view><view class="small muted">选择有标记的日期，查看完成公告。</view><button wx:if="{{recentDate && recentDate!==selected}}" class="text-button" bindtap="recentRecord">查看最近一次记录 →</button></view>
      </view>
    </view>
    <view class="record-notes"><button aria-expanded="{{recordNotesOpen}}" bindtap="toggleRecordNotes"><text>近半年记录</text><text>收录说明 {{recordNotesOpen?'⌃':'⌄'}}</text></button><view wx:if="{{recordNotesOpen}}" class="record-note-copy">{{periodLabel}}<view>按公开完成声明的北京时间归档。未收录记录不代表当日没有发生重置。</view></view></view>
  </block>
</view>
