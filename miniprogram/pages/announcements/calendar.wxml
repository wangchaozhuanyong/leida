<view class="page records-page {{contentMotion}}">
  <view wx:if="{{snapshotPending && connected && !error}}" class="cached-content-note" role="status">正在更新上次内容</view>
  <status-panel wx:if="{{!connected}}" variant="calendar" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">{{error}}<button class="text-button" bindtap="retry">重新加载</button></view>
    <view class="record-sheet motion-container">
      <view class="month-calendar motion-step motion-step-0">
        <view class="month-heading">
          <view><picker mode="selector" range="{{months}}" range-key="label" value="{{monthIndex}}" bindchange="selectMonth"><view class="month-select">{{months[monthIndex].label}} ⌄</view></picker></view>
          <view class="month-controls"><button aria-label="上个月" disabled="{{monthIndex===months.length-1}}" bindtap="previousMonth">‹</button><button aria-label="下个月" disabled="{{monthIndex===0}}" bindtap="nextMonth">›</button></view>
        </view>
        <view class="month-subtitle">本月全部 · 完成声明 {{confirmedCount}} 条 · 观测日期 {{observedDateCount}} 天</view>
        <view wx:if="{{observedCount}}" class="month-count-note">共 {{observationEvidenceCount}} 条来源记录，可展开查看。</view>
        <view class="record-kinds"><button wx:for="{{kinds}}" wx:key="value" aria-pressed="{{kind===item.value}}" class="{{kind===item.value?'active':''}}" data-value="{{item.value}}" bindtap="selectKind"><view wx:if="{{item.value!=='all'}}" class="record-dot {{item.value}}" />{{item.label}}<text class="kind-count">{{item.value==='all'?automaticCount+bankedCount:item.value==='automatic_reset'?automaticCount:bankedCount}}</text></button></view>
        <view class="month-week"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view class="month-days"><block wx:for="{{days}}" wx:key="date"><view wx:if="{{item.blank}}" class="blank-day" /><button wx:else class="{{item.selected?'selected':''}} {{item.today?'today':''}}" disabled="{{item.disabled}}" aria-label="{{item.date}}，完成确认{{item.confirmedCount}}条，来源观测{{item.observedCount}}条" aria-pressed="{{item.selected}}" data-date="{{item.date}}" bindtap="selectDay" hover-class="day-pressed"><view class="day-number">{{item.day}}</view><view class="day-markers" aria-hidden="true"><view wx:if="{{item.confirmedAutomatic}}" class="record-dot automatic_reset"/><view wx:if="{{item.confirmedBanked}}" class="record-dot banked_reset"/><view wx:if="{{item.observed}}" class="record-dot observed"/></view></button></block></view>
        <view class="record-legend"><view><view class="record-dot automatic_reset"/>额度确认</view><view><view class="record-dot banked_reset"/>重置卡确认</view><view><view class="record-dot observed"/>来源观测</view></view>
      </view>
      <view class="record-detail motion-step motion-step-1">
        <view class="record-heading"><text>{{selectedLabel}}</text><text class="record-count">{{selectedItems.length}} 条记录 · 北京时间</text></view>
        <block wx:for="{{selectedItems}}" wx:key="id">
          <button class="date-record" aria-label="{{item.title}}，{{item.timeLabel}} {{item.time}}，{{item.statusLabel}}，查看依据" data-path="{{item.path}}" bindtap="navigate"><text class="record-seal {{item.kind}} {{item.evidenceType}}" aria-hidden="true">{{item.evidenceType==='observed'?'◎':'✓'}}</text><view class="record-copy"><view class="record-meta"><text class="record-label {{item.kind}}">{{item.label}}</text><text class="record-status {{item.evidenceType}}">{{item.statusLabel}}</text><text class="record-time">{{item.time}}</text></view><view class="record-title">{{item.title}}</view><view wx:if="{{item.evidenceType==='observed'}}" class="record-source">{{item.isObservationSummary ? item.sourceCount+'个来源 · '+item.timeLabel+' '+item.time : item.sourceName}}</view></view><text class="record-chevron" aria-hidden="true">›</text></button>
          <view wx:if="{{item.sources.length>1}}" class="record-sources"><button class="text-button" data-id="{{item.id}}" bindtap="toggleRecordSources" aria-expanded="{{expandedRecord===item.id}}">{{expandedRecord===item.id?'收起':'查看'}} {{item.evidenceCount}} 条来源依据</button><view wx:if="{{expandedRecord===item.id}}"><button wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="record-source-link" data-path="{{source.path}}" bindtap="navigate">{{source.title}} · {{source.time}} →</button></view></view>
        </block>
        <view wx:if="{{!selectedItems.length}}" class="date-empty"><view>这一天暂无已收录记录</view><view class="small muted">选择有标记的日期，查看完成声明或来源观测。</view><button wx:if="{{recentDate && recentDate!==selected}}" class="text-button" bindtap="recentRecord">查看最近一次记录 →</button></view>
      </view>
    </view>
    <view class="recent-reset-sheet motion-step motion-step-2">
      <view class="recent-reset-heading"><text>近半年重置记录</text><text class="recent-reset-count">已显示 {{recentRecords.length}} / {{recentTotal}} 条</text></view>
      <view class="recent-reset-note">{{periodLabel}} · 北京时间</view>
      <block wx:for="{{recentRecords}}" wx:key="id"><button class="recent-reset-row" data-path="{{item.path}}" bindtap="navigate" aria-label="{{item.recordTitle}}，{{item.timeLabel}} {{item.date}} {{item.time}}，{{item.statusLabel}}{{item.sourceName ? '，'+item.sourceName : ''}}，查看依据" hover-class="recent-reset-pressed">
        <view class="recent-reset-icon {{item.kind}}"><image src="/assets/icons/{{item.kind==='banked_reset'?'card':'reset'}}.png" aria-hidden="true"/></view>
        <view class="recent-reset-copy">
          <view class="recent-reset-head"><text class="recent-reset-title">{{item.recordTitle}}</text><text class="recent-reset-time">{{item.date}}<text class="recent-reset-clock">{{item.time}}</text></text></view>
          <view class="recent-reset-meta"><text class="record-status {{item.evidenceType}}">{{item.statusLabel}}</text><text wx:if="{{item.sourceName}}" class="recent-reset-source">{{item.isObservationSummary ? item.sourceCount+'个来源 · '+item.timeLabel : item.sourceName}}</text></view>
        </view>
        <text class="record-chevron" aria-hidden="true">›</text>
      </button><view wx:if="{{item.sources.length>1}}" class="record-sources"><button class="text-button" data-id="{{item.id}}" bindtap="toggleRecordSources" aria-expanded="{{expandedRecord===item.id}}">{{expandedRecord===item.id?'收起':'查看'}} {{item.evidenceCount}} 条来源依据</button><view wx:if="{{expandedRecord===item.id}}"><button wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="record-source-link" data-path="{{source.path}}" bindtap="navigate">{{source.title}} · {{source.time}} →</button></view></view></block>
      <view wx:if="{{!recentRecords.length}}" class="recent-reset-empty">当前类型暂无已收录记录</view>
      <button wx:elif="{{recentHasMore}}" class="recent-reset-more" bindtap="moreRecords" hover-class="recent-reset-pressed">查看更早记录 ↓</button>
      <view wx:else class="recent-reset-end">已显示当前类型全部已收录记录</view>
    </view>
    <view class="record-notes motion-step motion-step-3"><button aria-expanded="{{recordNotesOpen}}" bindtap="toggleRecordNotes"><text>近半年记录</text><text>收录说明 {{recordNotesOpen?'⌃':'⌄'}}</text></button><view wx:if="{{recordNotesOpen}}" class="record-note-copy">{{periodLabel}}<view>记录来自公开完成声明和第三方观测，均可查看来源。时间为北京时间；未收录的日期不代表没有重置。活动日期请以活动页标注为准。</view></view></view>
  </block>
</view>
