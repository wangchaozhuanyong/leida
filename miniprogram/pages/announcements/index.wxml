<page-meta root-background-color="#f2f5fb" page-style="background-color:#f2f5fb" />
<navigation-header title="{{navigationTitle || '重置公告'}}" />
<view class="page">

    <view class="chips"><button wx:for="{{filters}}" wx:key="value" class="{{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</button></view>
  <view class="schedule-actions"><button class="text-button date-schedule-link" data-path="/pages/replay/index" bindtap="navigate">历史预测回放 →</button><button class="text-button date-schedule-link" data-path="/pages/schedule/index" bindtap="navigate">按日期查看日程 →</button></view>
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else><view wx:if="{{error}}" class="warning">{{error}}<button class="secondary" bindtap="retry">重新加载</button></view>
    <button wx:if="{{updateAvailable}}" class="update-prompt" bindtap="applyUpdates">有新内容 · 点击更新</button>
    <view wx:if="{{moreError}}" class="warning">{{moreError}}<button class="text-button" bindtap="more">重试加载更多</button></view>
    <view wx:for="{{items}}" wx:key="id" class="reading-item" data-reading-id="{{item.id}}"><view wx:if="{{item.month}}" class="month-heading">{{item.month}}</view><publication-card item="{{item}}" /></view>
    <view wx:if="{{!items.length}}" class="card empty"><view class="heading">暂无相关公告</view><view>此分类尚无已发布事件。</view></view>
    <button wx:if="{{hasMore}}" class="secondary full" bindtap="more" loading="{{loadingMore}}" disabled="{{loadingMore || refreshing}}">加载更多</button><view class="foot">资料截至 {{cutoff}} · 北京时间</view>
  </block>
</view>
