.activity-intro{padding:12px 2px 18px}.activity-kicker{font-size:11px;letter-spacing:2px;color:#6982ae;margin-bottom:7px}.activity-intro .title{font-size:26px;line-height:1.4;margin:0}.activity-subtitle{font-size:12px;color:#74819a;margin-top:9px}.activity-progress{height:4px;overflow:hidden;border-radius:4px;background:#e0e8f6;margin-top:18px}.activity-progress view{height:100%;background:#6896ec}.activity-phase{font-size:11px;color:#6f7f99;margin-top:5px}.activity-phase button{font-size:11px;min-height:44px}.activity-rules{padding:12px 0;font-size:12px}.activity-calendar{padding:18px 12px;border-color:#e0e7f1;border-radius:20px}.activity-today{font-size:11px;line-height:1.4;min-height:40px;padding:8px 10px;border-radius:9px;background:#eff5ff;color:#3068c4;margin:0}.activity-legend{display:flex;flex-wrap:wrap;gap:5px 12px;margin:10px 0 14px;font-size:10px}.type-blue{color:#2875ce}.type-teal{color:#158a83}.type-violet{color:#8756ca}.type-amber{color:#b57c24}.type-slate{color:#8b97aa}.challenge-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px 3px}.challenge-day{position:relative;margin:0;padding:8px 0 7px;min-width:0;min-height:72px;border:1px solid transparent;border-radius:11px;background:#f4f7fb;color:#334361;line-height:1.3;display:flex;flex-direction:column;align-items:center;justify-content:center}.challenge-day::after,.activity-arrows button::after,.activity-today::after{border:0}.challenge-day.is-selected{background:#edf4ff;border-color:#82aaf2;box-shadow:inset 0 0 0 1px #c9dcff}.challenge-day.is-future{background:#f9fafc;color:#9da8ba}.challenge-number{font-size:18px;font-weight:650}.challenge-date{font-size:9px;color:#8a95a9;margin:3px 0}.challenge-label{font-size:9px;font-weight:500;white-space:normal;line-height:1.4}.challenge-today-dot{position:absolute;right:4px;top:4px;width:4px;height:4px;border-radius:50%;background:#3078db}.activity-zone{font-size:10px;color:#8a95aa;margin-top:14px;line-height:1.6}.activity-selected{margin:24px 2px 12px}.activity-selected .heading{font-size:21px}.activity-arrows{display:flex;gap:6px}.activity-arrows button{margin:0;width:40px;min-height:44px;padding:0;font-size:24px;line-height:40px;background:#fff;border:1px solid #dfe6f1;border-radius:10px;color:#6a7891}.activity-arrows button[disabled]{opacity:.35}.activity-content{min-height:240px}.activity-empty{min-height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px}.activity-empty .small{max-width:260px;line-height:1.8}.activity-entry-card{border-radius:18px}.activity-badges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;align-items:center}.activity-type{background:#f0f5fc;font-size:11px;padding:4px 8px;border-radius:6px}.activity-stage{font-size:10px;color:#7b879c}.activity-entry-footer{gap:8px;margin-top:12px;flex-wrap:wrap}.activity-entry-footer button{font-size:11px;min-height:44px}.activity-entry-footer .small{font-size:10px}.activity-page .foot{font-size:10px;color:#8895a8;margin-top:20px}@media(max-width:350px){.activity-calendar{padding-left:8px;padding-right:8px}.challenge-grid{gap:5px 2px}.challenge-day{border-radius:8px}.challenge-number{font-size:17px}.challenge-label{font-size:8px}.activity-legend{gap:5px 8px}}

.activity-reset-note{font-size:10px;line-height:1.7;margin:-6px 0 12px}
