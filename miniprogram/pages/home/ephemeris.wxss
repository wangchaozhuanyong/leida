/* Motion adapted from Magic UI Orbiting Circles, MIT. See Magic-UI-LICENSE.txt.
   Upstream 43c0915a4e319e1eb037c55f7714f488c9ad238d, registry orbit keyframes. */
.radar-panel{--ink:#162945;--accent:#3565a9;--mist:#d6e6fb;--face:#f5f8fd;position:relative;background:linear-gradient(155deg,#fff 8%,var(--face) 63%,#fff);border:1px solid #d3ddec;border-radius:18px;overflow:hidden;color:var(--ink);box-shadow:0 5px 18px #1c38500a}
.radar-panel.kind-banked_reset{--accent:#7054a2;--mist:#e6ddf5;--face:#f8f6fc}
.radar-mast{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 16px;padding:14px 0 10px;border-bottom:1px solid #e2e8f1}
.radar-name{display:flex;align-items:center;gap:8px;color:var(--ink);font-size:16px;font-weight:600}
.radar-mark{width:10px;height:10px;box-sizing:border-box;border:2px solid var(--accent);border-radius:50%}
.radar-basis{font-size:12px;color:var(--accent)}
.radar-field{height:248px;position:relative;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 46%,var(--mist) 0%,transparent 65%)}
.radar-face{--radius:100px;position:relative;width:224px;height:224px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(140deg,#fff 0%,var(--mist) 32%,#9dacc494 42%,#fff 51%,var(--mist) 75%,#fff 93%);box-shadow:0 4px 15px #35577c14,inset 0 0 0 1px #a7b9cd65}
.radar-face::before,.radar-face::after{content:"";position:absolute;border-radius:50%;pointer-events:none}
.radar-face::before{inset:3px;background:repeating-conic-gradient(from 0deg,#798fa866 0deg 0.6deg,transparent 0.6deg 6deg)}
.radar-face::after{inset:8px;border:1px solid #cad7e6;background:radial-gradient(circle at 34% 24%,#fff 8%,var(--face) 72%,var(--mist));box-shadow:inset 0 0 0 5px #ffffff82,inset 0 0 0 6px #c6d5e74d}
.radar-pearl{position:absolute;left:50%;top:50%;width:7px;height:7px;margin:-3.5px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--mist),0 0 8px var(--accent);z-index:1;transform:rotate(-42deg) translateY(var(--radius)) rotate(42deg);animation:radar-orbit 26s linear infinite;animation-play-state:paused}
.radar-panel.is-live .radar-pearl{animation-play-state:running}
@keyframes radar-orbit{from{transform:rotate(-42deg) translateY(var(--radius)) rotate(42deg)}to{transform:rotate(318deg) translateY(var(--radius)) rotate(-318deg)}}
.radar-readout{position:relative;z-index:2;text-align:center;max-width:174px}
.radar-caption{color:#475c79;font-size:13px;line-height:20px;font-weight:500}
.radar-value{display:flex;align-items:baseline;justify-content:center;gap:8px;margin:6px auto;color:var(--ink);font-variant-numeric:tabular-nums}
.radar-number{font-size:35px;font-weight:600;letter-spacing:-1px;line-height:1.2}
.radar-unit{display:block;font-size:11px;line-height:18px;color:#5c708a;letter-spacing:0;font-weight:400}
.radar-value.long .radar-number{font-size:27px}
.radar-verdict{font-size:20px;font-weight:600;line-height:1.4;overflow-wrap:anywhere}
.radar-panel .orbit-facts{border:0;border-radius:0;background:#ffffff9c}
.radar-secondary{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-height:44px;margin:0;padding:8px 16px;background:#f4f7fb;border:0;border-radius:0;color:#334f76;font-size:13px;text-align:left;line-height:20px}
.radar-secondary::after{border:0}
@media(prefers-reduced-motion:reduce){.radar-panel .radar-pearl{animation:none}}
