/* The paper surface keeps the fold artwork behind a clear, flexible clock. */
.radar-panel {
  --ink: #182933;
  --accent: #315caa;
  position: relative;
  overflow: hidden;
  background: #f8f9f7;
  border: 1px solid #cbd4d0;
  border-radius: 16px;
  color: var(--ink);
}
.radar-panel.kind-banked_reset { --accent: #684d91; }
.radar-mast {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px 12px;
  margin: 0 20px;
  padding: 20px 0 0;
}
.radar-name { display: flex; align-items: center; gap: 8px; color: var(--accent); font-size: 13px; font-weight: 600; }
.radar-mark { flex: none; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
.radar-basis { margin-left: auto; color: var(--accent); font-size: 13px; text-align: right; }
.radar-field {
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 260px;
  padding: 24px 16px;
  box-sizing: border-box;
}
.signal-art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.signal-art::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, #f8f9f7 32%, #f8f9f7de 54%, #f8f9f700 78%);
}
.signal-wing { position: absolute; width: 280px; height: 192px; top: 50%; margin-top: -96px; }
.signal-wing-left { left: -150px; transform: rotate(-24deg); }
.signal-wing-right { right: -150px; transform: rotate(156deg); }
.signal-fold {
  display: block;
  width: 100%;
  height: 100%;
  opacity: .72;
  animation: signal-fold-breathe 20s ease-in-out infinite alternate paused;
}
.signal-wing-right .signal-fold { animation-delay: -10s; }
.radar-panel.is-live .signal-fold { animation-play-state: running; }
@keyframes signal-fold-breathe {
  from { transform: translateX(-5px) translateY(-3px); opacity: .60; }
  to { transform: translateX(5px) translateY(3px); opacity: .82; }
}
/* Keep the heading and every time column on the same horizontal center. */
.radar-readout { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 300px; min-width: 0; text-align: center; }
.radar-caption { width: 100%; text-align: center; color: var(--ink); font-size: 20px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
.radar-duration { width: 100%; min-width: 0; margin: 22px auto 0; font-variant-numeric: tabular-nums lining-nums; }
/* Reserve the date row even below one day, so crossing midnight cannot move the clock. */
.radar-calendar { display: flex; justify-content: center; align-items: baseline; flex-wrap: wrap; min-height: 2em; font-size: 16px; gap: 6px 12px; margin-bottom: 14px; line-height: 1.3; }
.radar-calendar-part { display: inline-flex; align-items: baseline; gap: 4px; white-space: nowrap; }
.radar-calendar-value { font-size: 24px; font-weight: 500; }
.radar-calendar-unit { color: #60716c; font-size: 12px; }
.radar-time { display: flex; align-items: flex-start; justify-content: center; width: 100%; gap: 3px; }
.radar-time-part { display: flex; flex-direction: column; align-items: center; flex: 1 1 0; min-width: 0; text-align: center; }
.radar-digits { display: block; width: 100%; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif; font-size: 50px; font-weight: 400; line-height: 1.1; letter-spacing: -1px; white-space: nowrap; }
.radar-unit { display: block; margin-top: 8px; color: #60716c; font-size: 12px; font-weight: 400; letter-spacing: .08em; line-height: 1.6; }
.radar-colon { display: block; flex: 0 0 8px; color: #91a5a4; font-size: 28px; font-weight: 300; line-height: 1.9; text-align: center; }
.radar-time-part.seconds .radar-digits { color: #627d83; }
.radar-verdict { font-size: 25px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.radar-secondary {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 10px 20px;
  border: 0;
  border-top: 1px solid #dbe0df;
  border-radius: 0;
  background: #edf1ef;
  color: #314f62;
  font-size: 13px;
  text-align: left;
  line-height: 1.6;
}
.radar-secondary::after { border: 0; }
@media (max-width: 360px) {
  .radar-mast { margin-left: 16px; margin-right: 16px; }
  .radar-field { min-height: 238px; padding-left: 12px; padding-right: 12px; }
  .radar-caption { font-size: 18px; }
  .radar-digits { font-size: 40px; }
  .radar-colon { font-size: 23px; line-height: 1.8; }
  .radar-calendar { gap: 6px 9px; }
}
@media (prefers-reduced-motion: reduce) { .signal-fold { animation: none; } }
