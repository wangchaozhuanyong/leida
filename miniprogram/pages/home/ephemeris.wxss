/* The paper surface keeps the fold artwork behind a clear, flexible clock. */
.radar-panel {
  --ink: #182933;
  --accent: #315caa;
  position: relative;
  overflow: hidden;
  background: #f8f9f7;
  border: 1px solid #cbd4d0;
  border-radius: 16px;
  color: var(--ink);
}
.radar-panel.kind-banked_reset { --accent: #684d91; }
.radar-mast {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px 12px;
  margin: 0 20px;
  padding: 20px 0 0;
}
.radar-name { display: flex; align-items: center; gap: 8px; color: var(--accent); font-size: 13px; font-weight: 600; }
.radar-mark { flex: none; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
.radar-basis { margin-left: auto; color: var(--accent); font-size: 13px; text-align: right; }
.radar-field {
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 260px;
  padding: 24px 16px;
  box-sizing: border-box;
}
.signal-art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.signal-art::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, #f8f9f7 32%, #f8f9f7de 54%, #f8f9f700 78%);
}
.signal-wing { position: absolute; width: 280px; height: 192px; top: 50%; margin-top: -96px; }
.signal-wing-left { left: -150px; transform: rotate(-24deg); }
.signal-wing-right { right: -150px; transform: rotate(156deg); }
.signal-fold {
  display: block;
  width: 100%;
  height: 100%;
  opacity: .72;
  animation: signal-fold-breathe 20s ease-in-out infinite alternate paused;
}
.signal-wing-right .signal-fold { animation-delay: -10s; }
.radar-panel.is-live .signal-fold { animation-play-state: running; }
@keyframes signal-fold-breathe {
  from { transform: translateX(-5px) translateY(-3px); opacity: .60; }
  to { transform: translateX(5px) translateY(3px); opacity: .82; }
}
.radar-readout { position: relative; width: 100%; max-width: 360px; min-width: 0; text-align: center; }
.radar-caption { color: var(--ink); font-size: 23px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.radar-value {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin: 14px auto 0;
  font-variant-numeric: tabular-nums;
}
.radar-number { flex: 0 1 46%; min-width: 0; font-size: 66px; font-weight: 500; letter-spacing: -.055em; line-height: 1.1; }
.radar-unit { display: block; margin-top: 5px; color: #53636b; font-size: 13px; font-weight: 400; letter-spacing: 0; line-height: 1.5; }
.radar-value.with-days .radar-number { flex: 1; font-size: 48px; }
.radar-value.long .radar-number { font-size: 40px; }
.radar-verdict { font-size: 25px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.radar-secondary {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 10px 20px;
  border: 0;
  border-top: 1px solid #dbe0df;
  border-radius: 0;
  background: #edf1ef;
  color: #314f62;
  font-size: 13px;
  text-align: left;
  line-height: 1.6;
}
.radar-secondary::after { border: 0; }
@media (max-width: 360px) {
  .radar-mast { margin-left: 16px; margin-right: 16px; }
  .radar-field { min-height: 238px; padding-left: 12px; padding-right: 12px; }
  .radar-number { font-size: 60px; }
  .radar-value.with-days .radar-number { font-size: 40px; }
  .radar-value.long .radar-number { font-size: 34px; }
}
@media (prefers-reduced-motion: reduce) { .signal-fold { animation: none; } }
