<view class="page home-page">
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">连接暂时中断，保留最近读取的资料。<button class="text-button" bindtap="retry" loading="{{loading}}">重新连接 →</button></view>
    <view wx:if="{{historical}}" class="warning">当前公告为历史收录，不代表刚刚发放。</view>
    <view class="freshness"><view class="freshness-summary" bindtap="toggleFreshness" role="button" aria-expanded="{{freshnessOpen}}"><view class="health-dot {{sourceDelayed ? 'delayed' : ''}}"></view><text>{{error ? '连接中断，保留已有资料' : sourceDelayed ? '部分来源更新延迟' : '自动检查公开消息'}}</text><text class="info-symbol">ⓘ</text></view><view wx:if="{{freshnessOpen}}" class="freshness-detail"><view>最近采集成功：{{collectedAt}} · 北京时间</view><view>最新消息发布于：{{latestSourceTime}} · 北京时间</view><view class="muted">成功时间来自最近成功的来源，不代表所有来源同时更新。</view></view></view>
    <instrument-dial model="{{dial}}" />
    <view wx:if="{{pending}}" class="outlook-summary"><view class="outlook-label">{{pending.label}} · {{pending.stage}}</view><view class="outlook-countdown">{{pending.countdown}}</view><view wx:if="{{pending.timed}}" class="muted">{{pending.time}} · 北京时间</view><view wx:if="{{pending.timeNote}}" class="small muted lead">{{pending.timeNote}}</view><view class="small muted lead">以原文安排及后续声明为准</view></view>
    <view wx:if="{{!pending}}" class="completion-records"><view wx:for="{{completions}}" wx:key="kind" class="completion-record" data-path="{{item.path}}" bindtap="navigate" role="button" aria-label="查看{{item.title}}的原文"><view class="title {{index > 0 ? 'secondary-title' : ''}}">{{item.title}}</view><view class="completion-time muted">{{item.time}} · 北京时间</view></view><view wx:if="{{!completions.length}}" class="completion-record"><view class="title">暂无公开完成记录</view><view class="completion-time muted">收录后将在这里更新</view></view></view>
    <view class="instrument-actions"><button class="primary full evidence-action instrument-action-button" data-path="{{pending ? pending.path : latest ? latest.path : '/pages/announcements/index'}}" bindtap="navigate"><view class="button-label"><image src="/assets/news-dark.png" class="action-icon" aria-hidden="true"/><text>{{pending ? '查看原文依据' : '查看最近发放依据'}}</text></view><text class="action-arrow">›</text></button><button class="secondary full subscribe-action instrument-action-button" bindtap="openWechatSettings"><view class="button-label"><image src="/assets/reminder.png" class="action-icon" aria-hidden="true"/><text>微信提醒</text></view><text class="action-arrow">›</text></button></view>
    <view class="share-panel"><view class="heading">分享重置动态</view><view class="small muted lead">{{posterDescription}}</view><view class="buttons lead"><button class="primary share-action-button" disabled="{{!posterPath}}" bindtap="openPoster">生成分享海报</button><button class="secondary share-action-button" open-type="share">分享给朋友</button></view></view>
    <view wx:if="{{pending && completions.length}}" class="previous-records"><view class="small muted">最近公开完成声明</view><view wx:for="{{completions}}" wx:key="kind" class="previous-record"><view class="row"><view class="grow">{{item.title}}</view><button class="text-button" data-path="{{item.path}}" bindtap="navigate">查看依据 →</button></view><view class="completion-time muted">{{item.time}} · 北京时间</view></view></view>
    <view wx:if="{{activity}}" class="activity-entry" data-path="{{activity.path}}" bindtap="navigate" role="button"><image src="/assets/calendar-gold.png" class="action-icon" aria-hidden="true"/><view class="grow"><view class="activity-title">{{activity.title}}</view><view class="small muted">{{activity.phase}} · 已收录{{activity.entries}}项进展</view></view><text class="activity-link">查看进展 →</text></view>
    <view class="row section"><view class="heading">最近动态</view><button class="text-button" data-path="/pages/news/index" bindtap="navigate">全部动态 →</button></view>
    <publication-card wx:for="{{recent}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!recent.length}}" class="card empty">暂无公开公告。</view>
    <view class="foot"><view>所有时间均为北京时间</view><button class="text-button footer-link" data-path="/pages/methodology/index" bindtap="navigate">查看判断规则</button></view>
  </block>
</view>
