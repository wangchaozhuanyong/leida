<page-meta root-background-color="#f2f5fb" page-style="background-color:#f2f5fb" />
<view class="page home-page">
  <view class="home-heading"><view class="home-heading-copy"><view class="home-heading-title">Codex重置</view><view class="home-heading-subtitle">不要错过每一次重置。</view></view><view class="freshness-summary" bindtap="toggleFreshness" role="button" aria-label="公开资料状态" aria-expanded="{{freshnessOpen}}"><view class="health-dot {{sourceDelayed || error ? 'delayed' : ''}}"></view><text>{{error ? connected ? '更新暂时中断' : '暂时无法连接' : connected ? sourceStatusLabel : loading ? '加载中' : '等待连接公开资料'}}</text><text class="info-symbol">ⓘ</text></view></view>
  <view wx:if="{{freshnessOpen && connected}}" class="freshness-detail"><view>最近采集成功：{{collectedAt}} · 北京时间</view><view>最新消息发布于：{{latestSourceTime}} · 北京时间</view><view class="muted">成功时间来自最近成功的来源，不代表所有来源同时更新。</view></view>
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">连接暂时中断，保留最近读取的资料。<button class="text-button" bindtap="retry" loading="{{loading}}">重新连接 →</button></view>
    <view wx:if="{{historical}}" class="warning">当前公告为历史收录，不代表刚刚发放。</view>
    <view wx:if="{{timeline}}" class="status-timeline {{timeline.completed ? 'is-completed' : ''}} {{timeline.scheduled ? 'is-scheduled' : ''}}" aria-label="公开重置进展">
      <neural-orb class="timeline-orb" aria-hidden="true" />
      <view class="timeline-head"><text>{{timeline.lead}}</text><text class="timeline-timezone">北京时间</text></view>
      <view class="timeline-row"><view class="timeline-title">{{timeline.title}}<text wx:if="{{timeline.scheduled}}" class="timeline-unit">小时 : 分钟</text></view><text class="timeline-symbol" aria-hidden="true">↗</text></view>
      <view class="timeline-note">{{timeline.note}}</view>
      <view class="timeline-stages" aria-label="公开进展阶段"><view wx:for="{{timeline.stages}}" wx:key="*this" class="timeline-stage {{timeline.currentStage === index ? 'current' : ''}}" aria-label="{{item}}{{timeline.currentStage === index ? '，当前阶段' : ''}}"><view class="stage-dot"/>{{item}}</view></view>
    </view>
    <view wx:if="{{pending.timeNote}}" class="timeline-time-note small muted">{{pending.timeNote}}</view>
    <view class="instrument-actions"><button class="primary full subscribe-action instrument-action-button" bindtap="openWechatSettings"><view class="button-label"><image src="/assets/neural/reminder-white.png" class="action-icon" aria-hidden="true"/><text>微信提醒</text></view></button><button class="secondary full evidence-action instrument-action-button" data-path="{{pending ? pending.path : latest ? latest.path : '/pages/announcements/index'}}" bindtap="navigate"><view class="button-label"><image src="/assets/neural/news-blue.png" class="action-icon" aria-hidden="true"/><text>查看依据</text></view><text class="action-arrow">›</text></button></view>
    <view wx:if="{{!pending}}" class="completion-records"><view wx:for="{{completions}}" wx:key="kind" class="completion-record" data-path="{{item.path}}" bindtap="navigate" role="button" aria-label="查看{{item.title}}的原文"><view class="title {{index > 0 ? 'secondary-title' : ''}}">{{item.title}}</view><view class="completion-time muted">{{item.time}} · 北京时间</view></view><view wx:if="{{!completions.length}}" class="completion-record"><view class="title">暂无公开完成记录</view></view></view>
    <button class="share-entry" disabled="{{!connected}}" bindtap="openPoster" hover-class="share-entry-pressed" aria-label="生成分享海报，分享重置动态，黑金或水墨两款可选">
      <view class="share-entry-posters" aria-hidden="true"><image class="share-entry-poster precision" src="/assets/posters/precision.jpg" mode="aspectFill"/><image class="share-entry-poster editorial" src="/assets/posters/editorial.jpg" mode="aspectFill"/></view>
      <view class="share-entry-copy"><view class="share-entry-title">分享重置动态</view><view class="share-entry-description">黑金 / 水墨 · 两款固定海报</view><view class="share-entry-action">生成分享海报</view></view>
      <text class="share-entry-arrow" aria-hidden="true">↗</text>
    </button>
    <view wx:if="{{pending && completions.length}}" class="previous-records"><view class="small muted">最近公开完成声明</view><view wx:for="{{completions}}" wx:key="kind" class="previous-record"><view class="row"><view class="grow">{{item.title}}</view><button class="text-button" data-path="{{item.path}}" bindtap="navigate">查看依据 →</button></view><view class="completion-time muted">{{item.time}} · 北京时间</view></view></view>
    <view wx:if="{{activity}}" class="activity-entry" data-path="{{activity.path}}" bindtap="navigate" role="button"><image src="/assets/neural/calendar-blue.png" class="action-icon" aria-hidden="true"/><view class="grow"><view class="activity-title">{{activity.title}}</view><view class="small muted">{{activity.phase}} · 已收录{{activity.entries}}项进展</view></view><text class="activity-link">查看进展 →</text></view>
    <view class="row section"><view class="heading">最近动态</view><button class="text-button" data-path="/pages/news/index" bindtap="navigate">全部动态 →</button></view>
    <publication-card wx:for="{{recent}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!recent.length}}" class="card empty">暂无公开公告。</view>
    <view class="foot"><view>所有时间均为北京时间</view><button class="text-button footer-link" data-path="/pages/privacy/index" bindtap="navigate">隐私说明</button></view>
  </block>
</view>
