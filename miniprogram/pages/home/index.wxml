<page-meta root-background-color="#f2f5fb" page-style="background-color:#f2f5fb" />
<navigation-header title="模钥重置雷达" brand="{{true}}" />
<view class="refresh-track {{refreshing ? 'is-active' : ''}}" aria-label="{{refreshing ? '正在更新' : ''}}"><view/></view>
<view class="page home-page">
  <view class="home-heading">
    <image class="home-atmosphere" src="/assets/neural/codex-reset-hero.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="home-atmosphere-fade" aria-hidden="true" />
    <view class="home-heading-copy"><view class="home-heading-title"><view class="home-heading-topic"><text class="home-heading-product">Codex</text><text>重置</text></view><view class="home-heading-accent">一目了然</view></view><view class="home-heading-subtitle">不要错过每一次重置。</view></view><view class="freshness-summary" bindtap="toggleFreshness" role="button" aria-label="公开资料状态" aria-expanded="{{freshnessOpen}}"><view class="health-dot {{sourceDelayed || error ? 'delayed' : ''}}"></view><text>{{error ? connected ? '更新暂时中断' : '暂时无法连接' : connected ? sourceStatusLabel : loading ? '加载中' : '等待连接公开资料'}}</text><text class="info-symbol">ⓘ</text></view>
  </view>
  <view wx:if="{{freshnessOpen && connected}}" class="freshness-detail"><view>最近采集成功：{{collectedAt}} · 北京时间</view><view>最新消息发布于：{{latestSourceTime}} · 北京时间</view><view class="muted">成功时间来自最近成功的来源，不代表所有来源同时更新。</view></view>
  <view wx:if="{{!connected}}" class="status-card reset-state tone-slate"><view class="reset-state-body"><view class="reset-state-meta"><text>公开动态追踪</text><text>{{error || unconfigured ? '连接异常' : '读取中'}}</text></view><view class="reset-state-heading"><view>{{error || unconfigured ? '暂时无法获取动态' : '正在获取公开动态'}}</view></view><view class="reset-state-description">{{error || unconfigured ? '当前没有可展示的缓存，连接恢复后更新。' : '正在读取公开消息和已确认记录。'}}</view><view wx:if="{{loading}}" class="refresh-track is-active"><view/></view></view><view class="reset-state-footer"><text>{{error || unconfigured ? '暂不能判断是否出现新消息' : '读取完成后显示来源'}}</text><button wx:if="{{error || unconfigured}}" class="text-button" bindtap="retry" disabled="{{loading}}">{{loading ? '正在重试…' : '重新获取 →'}}</button></view></view>
  <block wx:else>
    <view wx:if="{{error}}" class="warning">连接暂时中断，保留最近读取的资料。<button class="text-button" bindtap="retry" loading="{{loading}}">重新连接 →</button></view>
    <view wx:if="{{historical}}" class="warning">当前公告为历史收录，不代表刚刚发放。</view>
    <view class="home-dial"><instrument-dial model="{{dial}}" /></view>
    <view class="status-card">
    <view class="reset-states">
      <view class="reset-tabs" role="tablist" aria-label="重置类型"><button wx:for="{{resetCards}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="selectResetKind" class="{{selectedResetKind === item.kind ? 'selected' : ''}}" role="tab" aria-selected="{{selectedResetKind === item.kind}}"><text>{{item.name}}</text><text>{{item.badge}}</text></button></view>
      <view wx:if="{{stateWarning}}" class="reset-state-warning">{{stateWarning}}</view>
      <block wx:for="{{resetCards}}" wx:key="kind"><template wx:if="{{selectedResetKind === item.kind}}" is="reset-state" data="{{card:item,expanded:expandedSourceKind===item.kind}}"/></block>
      <view wx:if="{{untypedSignal}}" class="reset-untyped"><view>类型暂未明确的公开线索</view><template is="reset-state" data="{{card:untypedSignal,expanded:expandedSourceKind==='untyped'}}"/></view>
      <view wx:if="{{signalExpiredNote}}" class="reset-expired">{{signalExpiredNote}}</view>
      <view wx:if="{{lastReset || lastCard}}" class="reset-last-facts"><block wx:if="{{lastReset}}"><view class="reset-last-heading"><text>上次额度重置</text><text>{{lastReset.time}} · 北京时间</text></view><view class="reset-elapsed">{{lastReset.elapsed}}<text>已过去</text></view></block><view wx:if="{{lastCard}}" class="reset-last-card"><text>上次发放重置卡</text><text>{{lastCard.time}} · 北京时间</text></view></view>
    </view>
    <view wx:if="{{completions.length}}" class="recent-complete"><view class="completion-heading"><view class="section-overline">最近完成</view><button class="text-button" data-path="/pages/announcements/index" bindtap="navigate">全部记录 →</button></view><view wx:for="{{completions}}" wx:key="id" class="completion-line" data-path="{{item.path}}" bindtap="navigate" hover-class="completion-line-pressed" role="button" aria-label="{{item.title}}，{{item.time}}，查看公告"><text class="completion-check" aria-hidden="true">✓</text><text class="completion-label">{{item.label}}</text><text class="completion-date">{{item.shortTime}}</text></view></view>
    <view class="instrument-actions"><button class="primary subscribe-action instrument-action-button" bindtap="openWechatSettings"><view class="button-label"><image src="/assets/neural/reminder-white.png" class="action-icon" aria-hidden="true"/><text>微信提醒</text></view></button><button class="text-button evidence-action" data-path="{{evidencePath}}" bindtap="navigate"><text>{{evidenceLabel}}</text><text class="action-arrow" aria-hidden="true">›</text></button></view>
    </view>
    <button class="share-entry" disabled="{{!connected}}" bindtap="openPoster" hover-class="share-entry-pressed" aria-label="生成分享海报，分享重置动态，黑金或水墨两款可选">
      <view class="share-entry-posters" aria-hidden="true"><image class="share-entry-poster precision" src="/assets/posters/precision.jpg" mode="aspectFill"/><image class="share-entry-poster editorial" src="/assets/posters/editorial.jpg" mode="aspectFill"/></view>
      <view class="share-entry-copy"><view class="share-entry-title">分享重置动态</view><view class="share-entry-description">生成海报，分享给朋友</view></view>

    </button>
    <view wx:if="{{activity}}" class="activity-entry" data-path="{{activity.path}}" bindtap="navigate" role="button"><image src="/assets/neural/calendar-blue.png" class="action-icon" aria-hidden="true"/><view class="grow"><view class="activity-title">{{activity.title}}</view><view class="small muted">{{activity.phase}}</view></view></view>
    <view class="row section"><view class="heading">重置动态</view><button class="text-button" data-path="/pages/news/index" bindtap="navigate">全部动态 →</button></view>
    <publication-card wx:for="{{recent}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!recent.length}}" class="card empty">暂无公开公告。</view>
    <view class="foot"><view>所有时间均为北京时间</view><button class="text-button footer-link" data-path="/pages/privacy/index" bindtap="navigate">隐私说明</button></view>
  </block>
</view>

<template name="reset-state">
  <view class="reset-state tone-{{card.tone}}">
    <view class="reset-state-body">
      <view class="reset-state-meta"><text>{{card.evidence}}</text><text class="reset-state-badge">{{card.badge}}</text></view>
      <view class="reset-state-heading"><view>{{card.title}}</view><view class="reset-state-icon icon-{{card.icon}}" aria-hidden="true"><view/></view></view>
      <view class="reset-state-description">{{card.description}}</view>
      <view wx:if="{{card.window}}" class="reset-state-window"><text>信号发布时预计</text><view>{{card.window}}</view><text>不是承诺发放时间</text></view>
      <view wx:if="{{card.metric}}" class="reset-state-metric"><text>{{card.metricLabel}}</text><view>{{card.metric}}</view></view>
      <view class="reset-state-fact"><view><text>{{card.timeLabel}}</text><view>{{card.time}}</view><text wx:if="{{card.oldTime}}" class="reset-state-old">{{card.oldTime}}</text></view><text wx:if="{{card.timeAt}}" class="reset-state-zone">北京时间</text></view>
    </view>
    <view class="reset-state-footer"><text>{{card.footer}}</text><button class="text-button" data-kind="{{card.kind || 'untyped'}}" bindtap="openStatusEvidence">{{card.action}} →</button></view>
    <view wx:if="{{expanded && card.sourceName}}" class="reset-state-source"><view>来源：{{card.sourceName}}{{card.sourceType === 'observed' ? ' · 观察记录' : ''}}</view><view wx:if="{{card.watchNote}}">{{card.watchNote}}</view><button wx:if="{{card.sourceUrl}}" class="text-button" data-url="{{card.sourceUrl}}" bindtap="copyStatusSource">复制来源原文链接 ↗</button><view wx:else>此观察记录没有公开原文链接。</view></view>
  </view>
</template>
