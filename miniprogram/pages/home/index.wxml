<page-meta root-background-color="#f2f5fb" page-style="background-color:#f2f5fb" />
<navigation-header title="模钥重置雷达" brand="{{true}}" />
<view class="refresh-track {{refreshing ? 'is-active' : ''}}" aria-label="{{refreshing ? '正在更新' : ''}}"><view/></view>
<view class="page home-page {{motionActive && connected && !error ? 'motion-live' : ''}}">
  <view class="home-heading">
    <view class="home-heading-title">Codex 重置，一目了然</view>
    <button class="freshness-summary" bindtap="toggleFreshness" aria-label="公开资料状态" aria-expanded="{{freshnessOpen}}"><view class="health-dot {{snapshotPending ? 'cached' : sourceDelayed || error ? 'delayed' : ''}}" aria-hidden="true"/><text>{{snapshotPending ? '上次公开资料 · 待更新' : error ? connected ? '更新暂时中断' : '暂时无法连接' : connected ? sourceStatusLabel : loading ? '正在读取公开消息' : '等待连接公开资料'}}</text><text class="info-symbol" aria-hidden="true">ⓘ</text></button>
  </view>
  <view wx:if="{{freshnessOpen && connected}}" class="freshness-detail"><view>来源最近更新：{{collectedAt}} · 北京时间</view><view>最新消息发布于：{{latestSourceTime}} · 北京时间</view><view class="muted">来源分别更新；具体重置时间请查看对应消息。</view></view>
  <view wx:if="{{!connected && (clockUntrusted || error || unconfigured)}}" class="connection-card"><view class="connection-symbol" aria-hidden="true">◎</view><view class="connection-title">{{clockUntrusted ? '消息时间暂不可用' : '暂时无法获取动态'}}</view><view class="connection-description">{{clockUntrusted ? '请联网后重新加载；若仍异常，请检查手机日期和时间。' : '连接恢复后更新，暂不能判断是否出现新消息。'}}</view><button class="primary" bindtap="retry" disabled="{{loading}}">{{loading ? '正在重试…' : '重新获取'}}</button></view>
  <page-loader wx:elif="{{!connected}}" variant="home" />
  <view wx:else class="home-content {{contentMotion}}">
    <view class="home-update-note" role="status">{{snapshotPending ? error ? '正在显示上次内容，连接恢复后更新' : '正在更新上次读取的消息' : ''}}</view>
    <view wx:if="{{error}}" class="warning">连接暂时中断，正在显示上次内容。<button class="text-button" bindtap="retry" loading="{{loading}}">重新连接 →</button></view>
    <view wx:if="{{historical}}" class="warning">当前公告为历史收录，不代表刚刚发放。</view>
    <view class="reset-tabs" role="tablist" aria-label="重置类型"><button wx:for="{{resetCards}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="selectResetKind" class="reset-tab kind-{{item.kind}} {{selectedResetKind === item.kind ? 'selected' : ''}}" role="tab" aria-selected="{{selectedResetKind === item.kind}}" hover-class="tab-pressed"><image src="/assets/icons/{{item.kind==='banked_reset'?'card':'reset'}}.png" class="reset-tab-icon" aria-hidden="true"/><text>{{item.kind==='banked_reset'?'重置卡发放':'额度重置'}}</text></button></view>
    <view wx:if="{{stateWarning}}" class="reset-state-warning">{{stateWarning}}</view>
    <block wx:for="{{resetCards}}" wx:key="kind"><template wx:if="{{selectedResetKind === item.kind}}" is="reset-state" data="{{card:item,expanded:expandedSourceKind===item.kind,collectedAt:collectedAt}}"/></block>
    <view wx:if="{{untypedSignal}}" class="untyped-signal"><view class="untyped-title">发现相关消息</view><view>{{untypedSignal.description}}</view><view wx:if="{{untypedSignal.window}}">信号发布时推测：{{untypedSignal.window}}</view><button class="text-button" data-kind="untyped" bindtap="openStatusEvidence">查看信号依据 →</button><view wx:if="{{expandedSourceKind==='untyped'}}" class="reset-state-source"><view>来源：{{untypedSignal.sourceName}}</view><view>{{untypedSignal.watchNote}}</view><button wx:if="{{untypedSignal.sourceUrl}}" class="text-button" data-url="{{untypedSignal.sourceUrl}}" bindtap="copyStatusSource">复制来源原文链接 ↗</button></view></view>
    <view wx:if="{{signalExpiredNote}}" class="reset-expired">{{signalExpiredNote}}</view>
    <view class="home-card-actions"><button class="primary home-action" bindtap="openWechatSettings">微信提醒</button><button class="secondary home-action {{snapshotPending ? 'is-pending-snapshot' : ''}}" bindtap="openPoster" disabled="{{snapshotPending}}">{{snapshotPending ? '更新后可分享' : '分享动态'}}</button></view>
    <view wx:if="{{activity}}" class="activity-entry" data-path="{{activity.path}}" bindtap="navigate" role="button" hover-class="entry-pressed"><image src="/assets/neural/calendar-blue.png" class="action-icon" aria-hidden="true"/><view class="grow"><view class="activity-title">{{activity.title}}</view><view class="small muted">{{activity.phase}}</view></view><text aria-hidden="true">→</text></view>
    <view class="row home-news-heading"><view class="heading">重置动态</view><button class="text-button" data-path="/pages/news/index" bindtap="navigate">全部 →</button></view>
    <publication-card wx:for="{{recent}}" wx:key="id" item="{{item}}" compact="{{true}}" />
    <view wx:if="{{!recent.length}}" class="card empty">暂无公开公告，有新消息后会在这里更新。</view>
    <view class="foot"><view>所有时间均为北京时间</view></view>
  </view>
</view>

<template name="reset-state">
  <view class="reset-orbit tone-{{card.hero.tone}} state-{{card.state}} kind-{{card.kind}}" aria-label="{{card.hero.title || card.title}}">
    <view class="orbit-stage {{card.hero.animated ? 'can-animate' : ''}}">
      <view class="orbit-light" aria-hidden="true"/>
      <image class="orbit-art" src="/assets/neural/silver-orbit.png" mode="aspectFit" aria-hidden="true"/>
      <view class="orbit-scan" aria-hidden="true"/>
      <view class="orbit-path" aria-hidden="true"><view class="orbit-satellite"/></view>
      <view class="orbit-core">
        <view wx:if="{{card.hero.title && card.hero.metric}}" class="orbit-result">{{card.hero.title}}</view>
        <view class="orbit-label">{{card.hero.label}}</view>
        <block wx:if="{{card.hero.metric}}">
          <view class="orbit-digits {{card.hero.parts.length===3?'with-days':''}} {{card.hero.long?'is-long':''}}" aria-label="{{card.hero.title || card.hero.label}}，{{card.hero.metric}}"><block wx:if="{{card.hero.parts.length}}"><view wx:for="{{card.hero.parts}}" wx:key="unit" class="orbit-part" aria-hidden="true"><text class="orbit-number">{{item.value}}</text><text class="orbit-unit">{{item.unit}}</text></view></block><text wx:else class="orbit-minute">{{card.hero.metric}}</text></view>
        </block>
        <view wx:else class="orbit-title">{{card.hero.title}}</view>
        <view class="orbit-status"><text class="orbit-status-symbol" aria-hidden="true">{{card.hero.symbol}}</text><text>{{card.hero.badge}}</text></view>
      </view>
    </view>
    <view class="orbit-message"><view class="orbit-description">{{card.hero.description}}</view><view class="orbit-footnote">{{card.hero.footnote}}</view></view>
    <view wx:if="{{card.timeAt}}" class="orbit-schedule"><image class="fact-icon" src="/assets/neural/calendar-blue.png" aria-hidden="true"/><view class="orbit-date-copy"><view class="orbit-date-label">{{card.hero.timeLabel}}<text class="orbit-zone">北京时间</text></view><view class="orbit-date">{{card.dateText || card.time}}<text wx:if="{{card.clockText}}" class="orbit-clock">{{card.clockText}}<text class="orbit-qualifier">{{card.timeQualifier}}</text></text></view></view></view>
    <view wx:else class="orbit-waiting">收到明确预告后，将在这里展示时间。</view>
    <view wx:if="{{card.declarationTime}}" class="orbit-old">完成声明：{{card.declarationTime}} · 北京时间</view>
    <view wx:if="{{card.oldTime}}" class="orbit-old">{{card.oldTime}} · 北京时间</view>
    <view wx:if="{{card.observationPublicationId}}" class="independent-evidence"><view>另有第三方观测 · {{card.observationSourceName}}</view><view>{{card.observationTime}} · 北京时间</view><button class="text-button" data-kind="{{card.kind}}" bindtap="openObservation">查看观测 →</button></view>
    <view class="orbit-evidence"><view class="orbit-check"><view class="orbit-date-label">来源更新</view><text>{{collectedAt}}</text></view><button class="text-button" data-kind="{{card.kind}}" bindtap="openStatusEvidence">{{card.action}} →</button></view>
    <view wx:if="{{expanded && card.sourceName}}" class="reset-state-source"><view>来源：{{card.sourceName}}{{card.sourceType === 'observed' ? ' · 第三方观察记录' : ''}}</view><view wx:if="{{card.watchNote}}">{{card.watchNote}}</view><button wx:if="{{card.sourceUrl}}" class="text-button" data-url="{{card.sourceUrl}}" bindtap="copyStatusSource">复制来源原文链接 ↗</button><view wx:else>此观察记录没有公开原文链接。</view></view>
  </view>
</template>
