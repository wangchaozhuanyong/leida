<page-meta root-background-color="#f2f5fb" page-style="background-color:#f2f5fb" />
<navigation-header title="模钥重置雷达" brand="{{true}}" />
<view class="refresh-track {{refreshing ? 'is-active' : ''}}" aria-label="{{refreshing ? '正在更新' : ''}}"><view/></view>
<view class="page home-page">
  <view class="home-heading">
    <image class="home-atmosphere" src="/assets/neural/codex-reset-hero.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="home-atmosphere-fade" aria-hidden="true" />
    <view class="home-heading-copy"><view class="home-heading-title"><view class="home-heading-topic"><text class="home-heading-product">Codex</text><text>重置</text></view><view class="home-heading-accent">一目了然</view></view><view class="home-heading-subtitle">不要错过每一次重置。</view></view><view class="freshness-summary" bindtap="toggleFreshness" role="button" aria-label="公开资料状态" aria-expanded="{{freshnessOpen}}"><view class="health-dot {{sourceDelayed || error ? 'delayed' : ''}}"></view><text>{{error ? connected ? '更新暂时中断' : '暂时无法连接' : connected ? sourceStatusLabel : loading ? '加载中' : '等待连接公开资料'}}</text><text class="info-symbol">ⓘ</text></view>
  </view>
  <view wx:if="{{freshnessOpen && connected}}" class="freshness-detail"><view>最近采集成功：{{collectedAt}} · 北京时间</view><view>最新消息发布于：{{latestSourceTime}} · 北京时间</view><view class="muted">成功时间来自最近成功的来源，不代表所有来源同时更新。</view></view>
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" unconfigured="{{unconfigured}}" error="{{error}}" bindretry="retry" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">连接暂时中断，保留最近读取的资料。<button class="text-button" bindtap="retry" loading="{{loading}}">重新连接 →</button></view>
    <view wx:if="{{historical}}" class="warning">当前公告为历史收录，不代表刚刚发放。</view>
    <view class="status-card">
    <view wx:if="{{timeline}}" class="status-timeline tone-{{timeline.presentation.tone}} {{timeline.completed ? 'is-completed' : ''}} {{timeline.scheduled ? 'is-scheduled' : ''}} {{timeline.watching ? 'is-watching' : ''}} {{timeline.estimating ? 'is-estimating' : ''}}" aria-label="公开重置进展">
      <view class="timeline-main">
        <view class="timeline-copy">
          <view class="timeline-head"><text>{{timeline.presentation.kind}}</text><text class="state-badge">{{timeline.presentation.badge}}</text></view><view wx:if="{{timeline.scheduled}}" class="timeline-state-name">{{timeline.presentation.heading}}</view><view wx:if="{{timeline.scheduled}}" class="timeline-metric-label">{{timeline.lead}}</view>
          <view class="timeline-row"><view class="timeline-title {{timeline.title === '等待下一次 Reset' ? 'timeline-waiting' : ''}}"><block wx:if="{{timeline.scheduled && timeline.countdownParts.length}}"><text wx:for="{{timeline.countdownParts}}" wx:key="unit" class="duration-part">{{item.value}}<text class="duration-unit">{{item.unit}}</text></text></block><block wx:else>{{timeline.presentation.heading}}</block></view></view>
          <view class="timeline-date"><view class="timeline-note">{{timeline.note}}</view><text wx:if="{{timeline.scheduled || timeline.overdue || timeline.watching}}" class="timeline-timezone">北京时间</text></view><view wx:if="{{timeline.forecastWindow}}" class="timeline-detail">信号发布时预计：{{timeline.forecastWindow}}</view><view wx:if="{{timeline.observedLabel}}" class="timeline-detail">{{timeline.observedLabel}}</view><view wx:if="{{timeline.chanceLabel}}" class="timeline-detail">{{timeline.chanceLabel}}</view>
          <view wx:if="{{timeline.detail}}" class="timeline-detail">{{timeline.detail}}</view>
        </view>
        <neural-orb class="timeline-orb" aria-hidden="true" />
      </view>
      <view wx:if="{{timeline.sourceCredit}}" class="timeline-watch-sources"><button wx:if="{{timeline.sourceUrl}}" class="timeline-source-link" bindtap="copyWatchSource">{{timeline.sourceType === 'observed' ? '复制观察来源 ↗' : '复制来源原帖 ↗'}}</button><button class="timeline-provider-link" bindtap="copyWatchProvider">数据来自 {{timeline.sourceName}}</button></view>
      <view wx:if="{{historicalProbability}}" class="historical-probability"><view class="small muted">历史节奏参考</view><view class="historical-probability-values"><view wx:for="{{historicalProbability}}" wx:key="hours"><view class="small muted">{{item.hours}}小时内</view><view>{{item.label}}</view></view></view><view class="small muted">至少一次公共额度重置的累计概率，非官方安排</view></view>
      <view wx:if="{{lastReset}}" class="last-reset-clock"><view class="last-reset-caption"><text>上次额度重置</text><text>{{lastReset.time}} · 北京时间</text></view><view class="last-reset-duration">{{lastReset.elapsed}}</view></view>
      <view class="timeline-stages" aria-label="公开进展阶段"><view wx:for="{{timeline.stages}}" wx:key="*this" class="timeline-stage {{timeline.currentStage === index ? 'current' : ''}}" aria-label="{{item}}{{timeline.currentStage === index ? '，当前阶段' : ''}}"><view class="stage-dot"/>{{item}}</view></view>
    </view>
    <view wx:if="{{pending.timeNote}}" class="timeline-time-note small muted">{{pending.timeNote}}</view>
    <view wx:if="{{completions.length}}" class="recent-complete"><view class="completion-heading"><view class="section-overline">最近完成</view><button class="text-button" data-path="/pages/announcements/index" bindtap="navigate">全部记录 →</button></view><view wx:for="{{completions}}" wx:key="id" class="completion-line" data-path="{{item.path}}" bindtap="navigate" hover-class="completion-line-pressed" role="button" aria-label="{{item.title}}，{{item.time}}，查看公告"><text class="completion-check" aria-hidden="true">✓</text><text class="completion-label">{{item.label}}</text><text class="completion-date">{{item.shortTime}}</text></view></view>
    <view class="instrument-actions"><button class="primary subscribe-action instrument-action-button" bindtap="openWechatSettings"><view class="button-label"><image src="/assets/neural/reminder-white.png" class="action-icon" aria-hidden="true"/><text>微信提醒</text></view></button><button class="text-button evidence-action" data-path="{{evidencePath}}" bindtap="navigate"><text>{{evidenceLabel}}</text><text class="action-arrow" aria-hidden="true">›</text></button></view>
    </view>
    <button class="share-entry" disabled="{{!connected}}" bindtap="openPoster" hover-class="share-entry-pressed" aria-label="生成分享海报，分享重置动态，黑金或水墨两款可选">
      <view class="share-entry-posters" aria-hidden="true"><image class="share-entry-poster precision" src="/assets/posters/precision.jpg" mode="aspectFill"/><image class="share-entry-poster editorial" src="/assets/posters/editorial.jpg" mode="aspectFill"/></view>
      <view class="share-entry-copy"><view class="share-entry-title">分享重置动态</view><view class="share-entry-description">黑金 / 水墨 · 两款海报</view><view class="feature-action"><text>生成分享海报</text><signal-arrow class="feature-arrow" aria-hidden="true" /></view></view>

    </button>
    <view wx:if="{{activity}}" class="activity-entry" data-path="{{activity.path}}" bindtap="navigate" role="button"><image src="/assets/neural/calendar-blue.png" class="action-icon" aria-hidden="true"/><view class="grow"><view class="activity-title">{{activity.title}}</view><view class="small muted">{{activity.phase}} · 已收录{{activity.entries}}项进展</view><view class="feature-action">查看挑战进展 →</view></view></view>
    <view class="row section"><view class="heading">最近动态</view><button class="text-button" data-path="/pages/news/index" bindtap="navigate">全部动态 →</button></view>
    <publication-card wx:for="{{recent}}" wx:key="id" item="{{item}}" />
    <view wx:if="{{!recent.length}}" class="card empty">暂无公开公告。</view>
    <view class="foot"><view>所有时间均为北京时间</view><button class="text-button footer-link" data-path="/pages/privacy/index" bindtap="navigate">隐私说明</button></view>
  </block>
</view>
