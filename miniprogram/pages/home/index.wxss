/* One generous tap target; the poster choices are previews, not nested controls. */
.share-entry{width:100%;display:flex;align-items:center;justify-content:flex-start;gap:18px;min-height:116px;margin:16px 0 20px;padding:20px 18px;border:0;border-top:1px solid #91aaca;border-bottom:1px solid #ccd9ed;border-radius:0;background:linear-gradient(105deg,#ffffff,#e8effa);text-align:left;font-weight:400}
