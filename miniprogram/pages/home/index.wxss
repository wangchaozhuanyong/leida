.home-page .reset-state-body{padding:20px 16px 0}
.home-page .reset-state-footer,.home-page .reset-state-warning,.home-page .reset-expired{padding-left:16px;padding-right:16px}
.home-page .last-reset-card{margin-top:12px;padding:20px 16px 0}
.home-page .last-reset-record{margin-left:-16px;margin-right:-16px;padding-left:16px;padding-right:16px}
.home-page .home-card-actions{gap:8px;margin-top:12px}
.home-page .home-records{margin-top:12px;padding:0 16px}
.home-page .home-records .recent-complete{padding:20px 0}
