/* Silver orbit: all state text remains native, the image is decorative only. */
.home-page{position:relative;overflow:hidden;background:radial-gradient(ellipse 300px 370px at 100% 235px,rgba(185,214,255,.48),transparent),radial-gradient(ellipse 270px 370px at 0 330px,rgba(214,239,255,.8),transparent),linear-gradient(#f2f5fb 0,#edf5ff 300px,#f7faff 700px,#fff 1080px);color:#16284c;padding:12px 16px 32px}
.home-heading{text-align:center;padding:0 0 12px}.home-heading-title{letter-spacing:-.7px;color:#101f45;font-size:22px;font-weight:600;line-height:30px}.freshness-summary{display:flex;justify-content:center;align-items:center;gap:8px;margin:5px auto 0;padding:4px 8px;min-height:44px;background:none;border:0;color:#637596;font-size:12px;font-weight:400;line-height:1.5;white-space:normal}.freshness-summary::after{border:0}.health-dot{width:6px;height:6px;flex:none;border-radius:50%;background:#239384;box-shadow:0 0 0 4px rgba(35,147,132,.08)}.health-dot.delayed{background:#b37932;box-shadow:0 0 0 4px rgba(179,121,50,.08)}.info-symbol{font-size:15px}.freshness-detail{font-size:11px;line-height:1.85;background:rgba(255,255,255,.88);border:1px solid #e3eaf5;border-radius:16px;padding:12px;margin-bottom:16px;overflow-wrap:anywhere}.freshness-detail .muted{margin-top:6px}
.reset-tabs{display:flex;gap:4px;padding:4px;background:rgba(255,255,255,.6);border:1px solid #fff;box-shadow:0 4px 16px rgba(90,128,191,.06);border-radius:12px}.reset-tabs .reset-tab{display:flex;align-items:center;justify-content:center;gap:6px;flex:1;min-width:0;min-height:46px;padding:9px 4px;background:none;color:#536c96;font-size:14px;line-height:1.4;white-space:normal;border-radius:8px;font-weight:600}.reset-tabs .reset-tab::after{border:0}.reset-tabs .kind-banked_reset{color:#7760a4}.reset-tabs .selected{background:linear-gradient(120deg,#146aff,#3284fc);color:#fff;box-shadow:0 4px 12px rgba(37,111,243,.2)}.reset-tabs .kind-banked_reset.selected{background:linear-gradient(120deg,#714de0,#916ef0);color:#fff;box-shadow:0 4px 12px rgba(115,80,215,.16)}.reset-tab-icon{width:21px;height:21px;flex:none}.tab-pressed{opacity:.82}
.reset-state-warning,.reset-expired{padding:12px 14px;margin:12px 0 0;background:rgba(255,255,255,.78);border:1px solid #e0e9f7;line-height:1.75;color:#657896;font-size:12px;border-radius:16px}.home-page>.warning{margin:0 0 12px;font-size:12px}
.reset-orbit{--orbit-accent:#2868dc;--orbit-badge:#e8f1ff;--orbit-badge-text:#285fb9}.tone-slate{--orbit-accent:#7288ac;--orbit-badge:#edf2fa;--orbit-badge-text:#566b89}.tone-violet,.kind-banked_reset.tone-blue{--orbit-accent:#8164d9;--orbit-badge:#f0eaff;--orbit-badge-text:#7550bf}.tone-amber{--orbit-accent:#c68a36;--orbit-badge:#fff2dc;--orbit-badge-text:#9b6017}.tone-teal{--orbit-accent:#218f99;--orbit-badge:#e5f5f4;--orbit-badge-text:#18797e}.tone-green{--orbit-accent:#20876f;--orbit-badge:#e4f5ed;--orbit-badge-text:#217452}
.orbit-stage{position:relative;width:calc(100% + 32px);margin:0 -16px;aspect-ratio:1;display:flex;align-items:center;justify-content:center;isolation:isolate}.orbit-art{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.orbit-path{position:absolute;inset:12%;border:1px solid rgba(111,163,241,.17);border-radius:50%;pointer-events:none;animation:orbit-travel 28s linear infinite;animation-play-state:paused;transform:rotate(-24deg)}.orbit-satellite{position:absolute;left:50%;top:-3px;width:8px;height:8px;border-radius:50%;background:#b7e2ff;box-shadow:0 0 0 2px rgba(255,255,255,.85),0 0 12px #80baff}.orbit-core{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;width:52%;text-align:center;box-sizing:border-box;padding:9px 0;color:#17274b}.orbit-label{line-height:1.5;color:#637794;max-width:100%;font-size:12px}.orbit-title{font-size:20px;font-weight:700;line-height:1.4;margin:10px 0 12px;max-width:100%;overflow-wrap:anywhere}.orbit-result{line-height:1.5;margin:0 0 7px;max-width:100%;font-size:14px;font-weight:600}.orbit-digits{display:flex;align-items:baseline;justify-content:center;gap:14px;width:100%;margin:7px 0 11px;font-variant-numeric:tabular-nums}.orbit-part{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;flex:1;max-width:76px}.orbit-number{letter-spacing:-1.2px;color:#12264e;font-size:40px;font-weight:600;line-height:1.1}.orbit-unit{line-height:1.5;margin-top:4px;color:#596e8c;font-size:11px}.orbit-digits.with-days{gap:8px}.with-days .orbit-number{font-size:32px;letter-spacing:-.6px}.is-long .orbit-number{font-size:27px;letter-spacing:-.8px}.orbit-minute{font-size:21px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.orbit-status{display:flex;justify-content:center;align-items:center;gap:4px;max-width:100%;padding:5px 9px;box-sizing:border-box;border-radius:20px;background:var(--orbit-badge);color:var(--orbit-badge-text);line-height:1.45;font-weight:600;font-size:11px}.orbit-status-symbol{font-size:13px;flex:none}.orbit-message{text-align:center;margin:-4px 0 17px;padding:0 7px}.orbit-description{font-weight:600;color:#273e62;font-size:15px;line-height:24px}.orbit-footnote{line-height:1.8;margin-top:4px;font-size:12px;color:#4d607b}.state-cancelled .orbit-path,.state-cancelled .orbit-scan{display:none}.motion-live .can-animate .orbit-path,.motion-live .can-animate .orbit-scan,.motion-live .can-animate .orbit-light{animation-play-state:running}.state-cancelled .orbit-art{opacity:.6}
.orbit-schedule,.orbit-evidence{display:flex;align-items:center;gap:11px;background:rgba(255,255,255,.9);border:1px solid rgba(230,238,249,.9);border-radius:16px;box-shadow:0 6px 20px rgba(75,112,170,.025);padding:16px}.fact-icon{width:28px;height:28px;flex:none;padding:7px;background:#f1f7ff;border-radius:50%}.orbit-date-copy{flex:1;min-width:0}.orbit-date-label{line-height:1.6;font-size:12px;color:#4d607b}.orbit-zone{float:right;padding-left:5px;font-size:11px}.orbit-date{line-height:1.7;color:#20385f;overflow-wrap:anywhere;font-variant-numeric:tabular-nums;font-size:15px;font-weight:600}.orbit-clock{white-space:nowrap;margin-left:8px}.orbit-qualifier{margin-left:3px;font-weight:400;font-size:11px}.orbit-evidence{margin-top:8px;padding:7px 13px;gap:8px;flex-wrap:wrap;justify-content:space-between;border-radius:16px}.orbit-check{line-height:1.6;color:#566c8f;flex:1;min-width:120px;font-size:12px}.orbit-evidence .text-button{padding:3px 0;min-height:44px;white-space:normal;text-align:right;max-width:50%;line-height:1.5;font-size:12px}.orbit-waiting{background:rgba(255,255,255,.66);text-align:center;line-height:1.8;color:#73859c;font-size:12px;border-radius:16px;padding:16px}.orbit-old{line-height:1.8;padding:8px 14px 0;color:#77869d;font-size:11px}.independent-evidence{background:#eef8f8;border:1px solid #d7eeee;line-height:1.7;margin-top:8px;color:#477e82;font-size:12px;padding:16px;border-radius:16px}.independent-evidence .text-button{min-height:44px;padding:0;font-size:11px}.reset-state-source{margin-top:8px;background:rgba(255,255,255,.9);line-height:1.85;color:#637795;overflow-wrap:anywhere;font-size:12px;padding:16px;border-radius:16px}.reset-state-source .text-button{padding:0;min-height:44px;font-size:11px}.untyped-signal{margin-top:12px;background:rgba(246,243,255,.92);border:1px solid #e9e1fa;border-radius:16px;padding:14px;font-size:12px;line-height:1.8;color:#74658d}.untyped-title{font-weight:600;color:#6b51a0;margin-bottom:4px}.untyped-signal .text-button{padding:0;font-size:12px;min-height:44px}
.home-card-actions{display:flex;margin:14px 0 24px;gap:8px}.home-card-actions .home-action{flex:1;min-width:0;min-height:48px;padding:11px 6px;font-size:14px;line-height:1.5;white-space:normal;border-radius:8px;font-weight:500}.home-card-actions .primary{background:linear-gradient(115deg,#1668ff,#3185fc);box-shadow:0 8px 20px rgba(36,111,241,.15)}.home-card-actions .secondary{background:#eaf1fb;color:#203e6a;border-color:#e3ebf7}.activity-entry{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #e4ecf7;min-height:44px;padding:16px;border-radius:16px;margin:0 0 24px}.activity-entry .action-icon{width:32px;height:32px;flex:none}.activity-title{font-size:14px;line-height:1.6;font-weight:600}.entry-pressed{background:#f4f8ff}.home-news-heading{margin:0 0 10px}.home-news-heading .heading{color:#1b3155;font-size:17px;line-height:24px}.home-news-heading .text-button{min-height:44px;font-size:12px}.foot{text-align:center;line-height:1.8;margin-top:18px;font-size:11px;color:#4d607b}.footer-link{margin:0 auto;min-height:44px;font-size:11px}
.connection-card{text-align:center;border:1px solid #e0e8f6;background:rgba(255,255,255,.8);margin-top:14px;padding:32px 16px;border-radius:16px}.connection-symbol{font-size:46px;color:#87b5f6;line-height:1.5}.connection-title{margin:12px 0;font-size:17px;font-weight:600}.connection-description{color:#7587a0;font-size:15px;line-height:24px}.connection-card .primary{margin-top:20px;min-height:44px}
.orbit-scan{position:absolute;inset:14%;border:2px solid transparent;border-top-color:rgba(73,153,252,.48);border-right-color:rgba(137,209,255,.12);border-radius:50%;pointer-events:none;animation:orbit-scan-turn 12s linear infinite;animation-play-state:paused;transform:rotate(30deg)}
.orbit-light{position:absolute;inset:20%;border-radius:50%;background:radial-gradient(circle,#fff 28%,#f4f9ff 65%,rgba(220,237,255,.5));box-shadow:0 0 70px rgba(255,255,255,.94),inset 0 0 0 1px #e0eafa;animation:orbit-breathe 6s ease-in-out infinite;animation-play-state:paused}
@keyframes orbit-scan-turn{to{transform:rotate(390deg)}}
@keyframes orbit-breathe{0%,100%{opacity:.65;transform:scale(.97)}50%{opacity:1;transform:scale(1.025)}}
@keyframes orbit-travel{to{transform:rotate(336deg)}}
@media(max-width:350px){.home-heading-title{font-size:22px}.reset-tabs .reset-tab{font-size:13px}.reset-tab-icon{width:19px;height:19px}.orbit-title{font-size:18px}.orbit-number{font-size:38px}.with-days .orbit-number{font-size:29px}.is-long .orbit-number{font-size:24px}.orbit-label{font-size:11px}.orbit-status{font-size:11px;padding:4px 7px}.orbit-result{font-size:12px;margin-bottom:4px}.orbit-description{font-size:13px}.orbit-date{font-size:14px}.fact-icon{width:23px;height:23px;padding:5px}}
@media(min-width:600px){.home-page{max-width:480px;margin:auto}.orbit-stage{max-width:440px;margin-left:auto;margin-right:auto}.home-heading-title{font-size:22px}}
@media(prefers-reduced-motion:reduce){.orbit-path,.orbit-scan,.orbit-light{animation:none!important}.reset-tabs .reset-tab,.home-card-actions .home-action{transition:none!important}}

/* Pending snapshots keep the primary actions in place. */
.home-action.is-pending-snapshot{opacity:1;color:#6d7e98}

.health-dot.cached{background:#7c8da6;box-shadow:0 0 0 4px rgba(124,141,166,.08)}
