.timeline-stages{display:flex;justify-content:space-between;margin-top:10px;position:relative}
.timeline-stages::before{content:"";position:absolute;height:1px;left:4px;right:4px;top:4px;background:#b6cbec}
.timeline-stage{position:relative;flex:1;font-size:10px;line-height:15px;color:#4d607b;padding-top:13px;text-align:center}
.stage-dot{position:absolute;top:1px;left:calc(50% - 4px);width:7px;height:7px;background:#ffffff;border:1px solid #91aaca;border-radius:50%}
.timeline-stage:first-child{text-align:left}.timeline-stage:first-child .stage-dot{left:0}
.timeline-stage:last-child{text-align:right}.timeline-stage:last-child .stage-dot{left:auto;right:0}
.timeline-stage.current{color:#2458ce}.timeline-stage.current .stage-dot{background:#2458ce;border-color:#2458ce;box-shadow:0 0 0 3px #2458ce12}
.is-completed .timeline-stage.current{color:#21634b}.is-completed .timeline-stage.current .stage-dot{background:#21634b;border-color:#21634b;box-shadow:none}
.timeline-time-note{margin-top:8px;line-height:1.8}
.instrument-actions{flex-direction:row;gap:10px;margin:12px 0 0}
.instrument-actions .instrument-action-button{flex:1;min-width:0;min-height:46px;justify-content:center;padding:9px 6px;font-size:13px}
