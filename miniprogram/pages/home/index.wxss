/* Approved neural homepage; state text, dates and actions stay in the shared model. */
.home-page{position:relative;background:linear-gradient(#f2f5fb,#edf5ff 340px,#f7faff 700px,#fff 1080px);color:#14263e;padding:8px 16px 24px}
.home-heading{text-align:center;margin-bottom:12px}.home-heading-title{letter-spacing:-.7px;color:#101f45;font-size:22px;font-weight:600;line-height:30px}
.freshness-summary{display:flex;justify-content:center;align-items:center;gap:8px;margin:4px auto 0;padding:4px 8px;min-height:44px;background:none;border:0;color:#637596;font-size:12px;font-weight:400;line-height:20px;white-space:normal}.freshness-summary::after{border:0}.health-dot{width:6px;height:6px;flex:none;border-radius:50%;background:#239384;box-shadow:0 0 0 4px #23938414}.health-dot.delayed{background:#b37932;box-shadow:0 0 0 4px #b3793214}.health-dot.cached{background:#7c8da6;box-shadow:0 0 0 4px #7c8da614}.info-symbol{font-size:15px}
.freshness-detail{font-size:12px;line-height:20px;background:#fff;border:1px solid #dce5f1;border-radius:16px;padding:14px 16px;margin-bottom:16px;overflow-wrap:anywhere}.freshness-detail>view+view{margin-top:6px}
.reset-tabs{display:flex;gap:4px;padding:4px;background:#ffffffa6;border:1px solid #fff;box-shadow:0 4px 16px #5a80bf0f;border-radius:12px}.reset-tabs .reset-tab{display:flex;align-items:center;justify-content:center;gap:6px;flex:1;min-width:0;min-height:44px;padding:9px 4px;background:none;color:#536c96;font-size:14px;line-height:20px;white-space:normal;border-radius:8px;font-weight:500}.reset-tabs .reset-tab::after{border:0}.reset-tabs .kind-banked_reset{color:#7760a4}.reset-tabs .selected{background:linear-gradient(120deg,#146aff,#3284fc);color:#fff;box-shadow:0 4px 12px #256ff326}.reset-tabs .kind-banked_reset.selected{background:linear-gradient(120deg,#714de0,#916ef0);color:#fff}.reset-tab-icon{width:21px;height:21px;flex:none}.tab-pressed{opacity:.82}
.reset-expired{padding:12px 14px;margin:8px 0;border:1px solid #ddcba9;background:#f4ead6;border-radius:12px;color:#765422;font-size:12px;line-height:20px}.home-content>.warning{margin:8px 0;font-size:12px}
.reset-orbit{--orbit-badge:#e8f1ff;--orbit-badge-text:#285fb9}.tone-slate{--orbit-badge:#edf2fa;--orbit-badge-text:#566b89}.tone-violet{--orbit-badge:#f0eaff;--orbit-badge-text:#7550bf}.tone-amber{--orbit-badge:#fff2dc;--orbit-badge-text:#9b6017}.tone-teal{--orbit-badge:#e5f5f4;--orbit-badge-text:#18797e}.tone-green{--orbit-badge:#e4f5ed;--orbit-badge-text:#217452}
.orbit-status-stack{display:flex;flex-direction:column;min-height:288px;margin:8px 0 4px}.orbit-stage{position:relative;min-height:224px;flex:1;isolation:isolate}.home-neural-sphere{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.orbit-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;pointer-events:none}.orbit-core{width:196px;max-width:82%;padding:12px 0;background:radial-gradient(ellipse,#edf5fffa 20%,#edf5ffed 44%,#edf5ff00 72%)}
.orbit-result{font-size:14px;font-weight:500;line-height:22px;margin-bottom:4px;color:#17274b}.orbit-label{font-size:12px;line-height:18px;color:#596f8f}.orbit-title{font-size:22px;line-height:30px;font-weight:600;margin:10px 0;color:#142c55;overflow-wrap:anywhere}
.orbit-digits{display:flex;gap:8px;width:100%;max-width:188px;margin:12px auto 10px}.orbit-part{display:flex;flex-direction:column;align-items:center;flex:1;min-width:0}.orbit-number{font-size:40px;font-weight:600;line-height:44px;letter-spacing:-.6px;font-variant-numeric:tabular-nums;color:#12264e}.orbit-unit{font-size:12px;color:#596e8c;line-height:18px;margin-top:2px}.with-days .orbit-number{font-size:38px}.is-long .orbit-number{font-size:29px}.orbit-minute{font-size:23px;font-weight:600;line-height:32px;margin:10px auto;color:#12264e}
.orbit-status{display:inline-flex;gap:5px;align-items:center;justify-content:center;max-width:100%;min-height:24px;font-size:12px;line-height:20px;padding:2px 9px;border-radius:12px;color:var(--orbit-badge-text);background:var(--orbit-badge)}.orbit-status-symbol{flex:none}.orbit-message{margin:0 0 16px;padding:0 2px;font-size:14px;line-height:22px;text-align:left}.orbit-footnote{font-size:12px;line-height:20px;color:#4d607b;margin-top:6px}
.orbit-facts{border:1px solid #dce5f1;border-radius:16px;background:#fff;padding:0 16px}.orbit-schedule{display:flex;gap:10px;align-items:flex-start;padding:12px 0;border-bottom:1px solid #e7edf5}.orbit-date-label{font-size:12px;line-height:22px;color:#4d607b}.orbit-schedule>.orbit-date-label{width:78px;flex:none}.orbit-date{font-size:14px;line-height:22px;min-width:0;flex:1;font-weight:500;color:#14263e;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.orbit-clock{display:block}.orbit-qualifier{font-size:12px;line-height:20px;color:#4d607b;margin-top:3px;font-weight:400}
.orbit-evidence{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding:12px 0}.orbit-check{min-width:0;line-height:22px;font-size:13px;color:#14263e;font-variant-numeric:tabular-nums}.orbit-check .orbit-date-label{line-height:20px}.orbit-evidence>.text-button{display:flex;align-items:flex-end;justify-content:flex-end;min-width:76px;min-height:44px;padding-bottom:1px;text-align:right;white-space:nowrap;font-size:12px;flex:none}
.orbit-waiting{padding:14px 0;font-size:12px;line-height:20px;color:#4d607b;border-bottom:1px solid #e7edf5}.orbit-old{padding:10px 0;font-size:12px;line-height:20px;color:#4d607b;border-bottom:1px solid #e7edf5}.independent-evidence{padding:12px 0;border-bottom:1px solid #e7edf5;font-size:12px;line-height:20px;color:#4d607b}.independent-evidence .text-button{font-size:12px;min-height:44px}.reset-state-source{border-top:1px solid #e7edf5;padding:12px 0;font-size:12px;line-height:20px;color:#4d607b;overflow-wrap:anywhere}.reset-state-source>view+view{margin-top:6px}.reset-state-source .text-button{font-size:12px;min-height:44px;white-space:normal}
.untyped-signal{margin-top:12px;font-size:13px;line-height:22px;color:#4d607b}.untyped-title{font-size:15px;margin-bottom:6px;font-weight:600}.untyped-signal .text-button{font-size:12px;min-height:44px}.home-card-actions{display:flex;gap:12px;margin-top:16px}.home-card-actions .home-action{flex:1;min-width:0;min-height:46px;padding:10px 6px;font-size:14px;line-height:22px;white-space:normal;border-radius:10px;font-weight:500}.home-card-actions .primary{background:linear-gradient(115deg,#1d45a3,#2458ce);border-color:#2458ce}.home-card-actions .secondary{background:#ffffff94;border-color:#91aaca}.home-action.is-pending-snapshot{opacity:1;color:#6d7e98}
.activity-entry{display:flex;align-items:center;gap:12px;width:100%;padding:16px;background:#fff;border:1px solid #dce5f1;border-radius:16px;margin-top:16px}.activity-entry .action-icon{width:24px;height:24px;flex:none}.activity-title{font-size:15px;line-height:24px;font-weight:600}.activity-entry .small{font-size:12px;line-height:20px;margin-top:4px}.entry-pressed{background:#f4f8ff}.home-news-heading{gap:12px;margin:20px 0 8px}.home-news-heading .heading{font-size:17px;line-height:24px;font-weight:600}.home-news-heading .text-button{font-size:12px;min-height:44px}.foot{font-size:11px;line-height:20px;color:#4d607b;text-align:center;margin-top:20px}
.connection-card{text-align:center;padding:28px 16px;background:#fff;border:1px solid #dce5f1;border-radius:16px}.connection-symbol{font-size:46px;color:#87b5f6;line-height:1.5}.connection-title{font-size:20px;line-height:28px;margin:10px 0;font-weight:600}.connection-description{font-size:14px;line-height:22px;color:#4d607b;margin-bottom:16px}.connection-card .primary{min-height:46px}.home-content>.empty{font-size:14px;line-height:24px;padding:24px 16px}
@media(max-width:380px){.home-page{padding-left:14px;padding-right:14px}.reset-tabs .reset-tab{font-size:13px}.reset-tab-icon{width:19px;height:19px}.orbit-schedule>.orbit-date-label{width:72px}.orbit-schedule{gap:8px}.orbit-facts{padding-left:14px;padding-right:14px}.orbit-core{width:184px;max-width:82%}.orbit-number{font-size:36px}.with-days .orbit-number{font-size:34px}.is-long .orbit-number{font-size:25px;letter-spacing:-.5px}}
@media(min-width:600px){.home-page{max-width:480px;margin:auto}}
