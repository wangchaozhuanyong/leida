/* Status copy and decorative radar have separate columns; stages span the card. */
.status-timeline{width:100%;min-height:140px;padding:13px 15px 11px;border:1px solid #ccd9ed;border-radius:12px;background:linear-gradient(115deg,#ffffff,#e1eaf8)}
.timeline-main{display:flex;align-items:center;gap:12px;min-height:96px}
.timeline-copy{flex:1;min-width:0}
.timeline-head{color:#355a86;font-size:10px;line-height:16px;letter-spacing:.7px}
.timeline-timezone{margin-top:5px;color:#7085a0;font-size:9px;line-height:13px;letter-spacing:.5px}
.timeline-row{margin-top:5px}
.timeline-title{font-size:25px;font-weight:600;line-height:1.3;color:#14263e;word-break:break-word;font-variant-numeric:tabular-nums}
