.last-reset-heading{display:flex;align-items:baseline;flex-wrap:wrap;gap:2px 7px;min-width:0;font-size:14px;font-weight:600;line-height:1.6;letter-spacing:0;color:#14263e}.last-reset-caption{font-size:12px;font-weight:400;color:#4d607b;white-space:nowrap}
