.home-page{padding-top:8px}.freshness{margin-bottom:8px;font-size:11px;color:#4d607b}.freshness-summary{min-height:32px;display:inline-flex;align-items:center;gap:6px}.health-dot{width:6px;height:6px;border-radius:50%;background:#21634b;flex:none}.health-dot.delayed{background:#765422}.info-symbol{font-size:13px;line-height:1}.freshness-detail{padding:12px;border:1px solid #ccd9ed;border-radius:8px;line-height:2;margin-bottom:10px}.outlook-summary{padding-top:6px}.outlook-label{color:#2458ce;font-size:16px}.outlook-countdown{font-size:23px;line-height:1.5;font-weight:600;margin:12px 0 7px}.completion-record{margin:7px 0 18px}.completion-record .title{font-size:23px}.completion-time{font-size:12px;text-align:right;margin-top:8px}.instrument-actions{display:flex;flex-direction:column;gap:10px;margin:14px 0 20px}.instrument-actions .instrument-action-button{min-height:48px;justify-content:space-between}.button-label{display:flex;align-items:center;gap:10px}.action-icon{width:22px;height:22px;flex:none}.action-arrow{font-size:24px;line-height:1}.subscribe-action{border-color:#2458ce}.previous-record{border-top:1px solid #ccd9ed;padding:18px 0;font-size:14px}.activity-entry{display:flex;align-items:center;gap:12px;border-top:1px solid #ccd9ed;border-bottom:1px solid #ccd9ed;min-height:92px;padding:18px 0}.activity-title{font-size:14px;font-weight:600}.activity-entry .small{font-size:11px;margin-top:4px}.activity-link{font-size:11px;white-space:nowrap;color:#2458ce}.footer-link{justify-content:center;font-size:11px;min-height:32px}.home-page .section{margin-top:22px}
.completion-record + .completion-record{border-top:1px solid #ccd9ed;padding-top:16px;margin-top:0}.completion-record .secondary-title{font-size:16px;color:#4d607b}.previous-records{margin-bottom:14px}
.completion-record{display:flex;flex-direction:column;align-items:stretch}.completion-time{display:block;width:100%}

/* Retain the progress timeline geometry; the neural ornament is decorative. */
.status-timeline{width:100%;min-height:140px;padding:13px 15px 11px;border:1px solid #ccd9ed;border-radius:12px;background:linear-gradient(115deg,#ffffff,#e1eaf8)}
.timeline-head{display:flex;justify-content:space-between;align-items:center;gap:9px;color:#355a86;font-size:10px;line-height:16px;letter-spacing:.7px}
.timeline-timezone{font-size:9px;letter-spacing:0;white-space:nowrap}
.timeline-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:7px}
.timeline-title{font-size:25px;font-weight:600;line-height:1.3;color:#14263e;word-break:break-word;font-variant-numeric:tabular-nums}
.timeline-unit{font-size:10px;font-weight:400;margin-left:6px;white-space:nowrap;color:#355a86}
.timeline-symbol{font-size:28px;line-height:28px;flex:none;color:#91aaca}
.is-scheduled .timeline-title{color:#2458ce}.is-completed .timeline-title{color:#21634b}
.timeline-note{margin-top:5px;font-size:10px;line-height:15px;color:#4d607b}
.timeline-stages{display:flex;justify-content:space-between;margin-top:10px;position:relative}
.timeline-stages::before{content:"";position:absolute;height:1px;left:4px;right:4px;top:4px;background:#b6cbec}
.timeline-stage{position:relative;flex:1;font-size:10px;line-height:15px;color:#4d607b;padding-top:13px;text-align:center}
.stage-dot{position:absolute;top:1px;left:calc(50% - 4px);width:7px;height:7px;background:#ffffff;border:1px solid #91aaca;border-radius:50%}
.timeline-stage:first-child{text-align:left}.timeline-stage:first-child .stage-dot{left:0}
.timeline-stage:last-child{text-align:right}.timeline-stage:last-child .stage-dot{left:auto;right:0}
.timeline-stage.current{color:#2458ce}.timeline-stage.current .stage-dot{background:#2458ce;border-color:#2458ce;box-shadow:0 0 0 3px #2458ce12}
.is-completed .timeline-stage.current{color:#21634b}.is-completed .timeline-stage.current .stage-dot{background:#21634b;border-color:#21634b;box-shadow:none}
.timeline-time-note{margin-top:8px;line-height:1.8}
.instrument-actions{flex-direction:row;gap:10px;margin:12px 0 0}
.instrument-actions .instrument-action-button{flex:1;min-width:0;min-height:46px;justify-content:center;padding:9px 6px;font-size:13px}
.instrument-actions .button-label{gap:7px}.instrument-actions .action-icon{width:18px;height:18px}
.instrument-actions .subscribe-action{background:#2458ce;border-color:#2458ce;color:#ffffff}
.instrument-actions .evidence-action{background:#ffffff;border-color:#91aaca;color:#14263e}
.subscribe-action .action-icon{filter:none}
.instrument-actions .action-arrow{font-size:18px;margin-left:8px}
.completion-records{margin:0}.completion-records .completion-record{margin:0;padding:0;min-height:44px;justify-content:center}
.completion-records .completion-record+.completion-record{margin-top:8px;padding-top:8px}
.completion-records .title{font-size:12px;font-weight:400;line-height:1.6;color:#4d607b}
.completion-records .completion-time{font-size:10px;margin-top:3px;text-align:left;line-height:1.6}
@media(max-width:350px){.timeline-title{font-size:24px}.instrument-actions .instrument-action-button{font-size:12px}.instrument-actions .button-label{gap:4px}}
.home-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:56px;margin-bottom:10px}
.home-heading-copy{flex:none}.home-heading-title{font-size:20px;font-weight:650;line-height:28px;color:#14263e}
.home-heading-subtitle{font-size:10px;line-height:16px;margin-top:2px;color:#4d607b}
.home-heading .freshness-summary{min-height:44px;max-width:58%;justify-content:flex-end;font-size:10px;line-height:16px;color:#4d607b}
.freshness-detail{font-size:11px}

/* One generous tap target; the poster choices are previews, not nested controls. */
.share-entry{width:100%;display:flex;align-items:center;justify-content:flex-start;gap:18px;min-height:116px;margin:16px 0 20px;padding:20px 18px;border:0;border-top:1px solid #91aaca;border-bottom:1px solid #ccd9ed;border-radius:0;background:linear-gradient(105deg,#ffffff,#e8effa);text-align:left;font-weight:400}
.share-entry-pressed{background:#d9e6fb;border-top-color:#2458ce}
.share-entry-posters{position:relative;flex:none;width:50px;height:62px}
.share-entry-poster{position:absolute;width:34px;height:53px;border-radius:3px;box-shadow:0 3px 8px #0005}
.share-entry-poster.precision{left:0;top:6px;transform:rotate(-9deg);border:1px solid #6f6448}
.share-entry-poster.editorial{left:17px;top:0;transform:rotate(8deg);border:1px solid #d5d0bd}
.share-entry-copy{flex:1;min-width:0}
.share-entry-title{font-size:16px;line-height:24px;font-weight:600;letter-spacing:.3px;color:#14263e}
.share-entry-description{margin-top:3px;font-size:11px;line-height:18px;color:#4d607b}
.share-entry-action{margin-top:7px;font-size:12px;line-height:18px;color:#2458ce}
.share-entry-arrow{flex:none;margin-left:2px;font-size:25px;line-height:28px;color:#2458ce}
.share-entry[disabled]{background:transparent;color:#4d607b}
@media(max-width:350px){.share-entry{gap:14px;padding-left:16px;padding-right:16px}.share-entry-title{font-size:15px}.share-entry-description{font-size:10px}}

/* Silver neural skin: a small ornament stays behind the existing text. */
.status-timeline{position:relative;overflow:hidden;background-color:#e1eaf8;background-image:linear-gradient(110deg,#ffffff 0%,#ffffff 34%,transparent 100%),linear-gradient(#365bd209 1px,transparent 1px),linear-gradient(90deg,#365bd209 1px,transparent 1px);background-size:auto,18px 18px,18px 18px;box-shadow:inset 0 1px 0 #fff,0 8px 24px #1b457314}
.timeline-orb{position:absolute;top:15px;right:0;width:46%;max-width:170px;height:80px;z-index:0}
.timeline-head,.timeline-row,.timeline-note,.timeline-stages{position:relative;z-index:1}
.timeline-symbol{opacity:0}
.share-entry-poster{box-shadow:0 3px 8px #1b457326}

/* Static observatory artwork blends into the same opaque page background. */
.home-page{position:relative}
.home-atmosphere{position:absolute;top:0;left:0;width:100%;height:66.6667vw;max-height:400px;z-index:0;pointer-events:none}
.home-atmosphere-fade{position:absolute;top:0;left:0;width:100%;height:66.6667vw;max-height:400px;z-index:0;background:linear-gradient(180deg,#f2f5fb00 48%,#f2f5fb 100%);pointer-events:none}
.home-page>.home-heading,.home-page>.freshness-detail,.home-page>status-panel,.home-page>.warning,.home-page>.status-timeline,.home-page>.timeline-time-note,.home-page>.instrument-actions,.home-page>.completion-records,.home-page>.share-entry,.home-page>.previous-records,.home-page>.activity-entry,.home-page>.section,.home-page>publication-card,.home-page>.card,.home-page>.foot{position:relative;z-index:1}
.home-heading{flex-direction:column;align-items:flex-start;justify-content:center;gap:6px;min-height:124px;margin-bottom:12px}
.home-heading .freshness-summary{justify-content:flex-start;min-height:28px;max-width:100%}

/* Keep status, factual records and their actions in one stable reading group. */
.home-page>.status-card{position:relative;z-index:1;border:1px solid #ccd9ed;border-radius:17px;background:linear-gradient(130deg,#ffffffed,#f6f9fff2);overflow:hidden;box-shadow:0 8px 24px #264f8b06}
.status-card .status-timeline{min-height:136px;padding:16px 17px 14px;border:0;border-radius:0;background-color:transparent;box-shadow:none}
.status-card .timeline-time-note{margin:0;padding:0 17px 12px;font-size:10px}
.recent-complete{margin:0 17px;padding:10px 0;border-top:1px solid #e2eaf5}
.section-overline{font-size:10px;line-height:17px;color:#6d819d;letter-spacing:.3px;margin-bottom:4px}
.completion-line{display:flex;align-items:center;gap:7px;min-height:32px;font-size:12px;border-radius:4px}
.completion-line-pressed{background:#e8effa}
.completion-check{width:13px;flex:none;font-size:13px;color:#428971}
.completion-label{flex:none;color:#294264;font-weight:500}
.completion-date{margin-left:auto;color:#6d819d;font-size:10px;line-height:17px;text-align:right;font-variant-numeric:tabular-nums}
.status-card .instrument-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 17px;padding:13px 0 15px;border-top:1px solid #e2eaf5}
.status-card .instrument-action-button{flex:none;min-width:112px;min-height:44px;width:auto;padding:10px 17px;border-radius:10px;font-size:13px}
.status-card .evidence-action{display:flex;align-items:center;justify-content:flex-end;gap:7px;min-width:0;min-height:44px;padding:8px 0;border:0;border-radius:0;background:transparent;color:#617b9c;font-size:11px;box-shadow:none}
.status-card .evidence-action .action-arrow{font-size:19px;margin:0;color:#718eaf}

/* Blend the share row into the page; the small signal alone carries motion. */
.home-page>.share-entry{position:relative;overflow:hidden;min-height:102px;margin:12px 0 14px;padding:18px 16px;gap:14px;border:0;border-radius:0;background:transparent;box-shadow:none}
.share-entry::before,.share-entry::after{content:"";position:absolute;left:0;right:0;top:0;bottom:auto;width:auto;height:1px;border:0;border-radius:0;transform:none;background:linear-gradient(90deg,transparent,#c6d8f0 23%,#c6d8f0 77%,transparent);pointer-events:none}
.share-entry::after{top:auto;bottom:0}
.home-page>.share-entry-pressed{background:transparent}
.share-entry-pressed .share-entry-signal{transform:translate(1px,-1px)}
.share-entry .share-entry-title{font-size:15px;line-height:23px;letter-spacing:0}
.share-entry .share-entry-description{margin-top:5px;font-size:10px;line-height:17px}
.share-entry-signal{flex:none;width:44px;height:44px;margin-left:0;border-radius:50%;background:radial-gradient(circle,#dce9fd8a,transparent 70%)}
.share-entry .share-entry-posters{width:50px;height:59px}
.home-page>.activity-entry{border-top:0;min-height:78px;padding:14px 0}
@media(max-width:350px){.status-card .status-timeline{padding-left:15px;padding-right:15px}.recent-complete,.status-card .instrument-actions{margin-left:15px;margin-right:15px}.completion-date{font-size:9px}.status-card .instrument-action-button{min-width:105px;padding:10px 13px}.home-page>.share-entry{padding-left:12px;padding-right:12px;gap:11px}.share-entry .share-entry-title{font-size:14px}.share-entry .share-entry-description{font-size:9px}.share-entry-signal{width:40px}}
