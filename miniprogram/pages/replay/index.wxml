<navigation-header title="历史消息回放" back="{{true}}" />
<page-loader wx:if="{{loading && !view}}" />
<view wx:else class="page">
 <view class="card"><view class="heading">近一个月历史回放</view><view class="prose muted">真实消息 · 历史模拟。预测按每一步固定保存，与实时记录分别统计。</view></view>
 <view wx:if="{{error}}" class="warning"><view>{{error}}</view><button class="secondary full" bindtap="retry">重新加载</button></view>
 <view wx:if="{{empty}}" class="card muted">尚无已完成的回放批次。</view>
 <view wx:if="{{view}}" class="card">
  <view class="small muted">{{view.range}} · 北京时间</view><view class="prose">窗口内{{view.count}}条消息 · 第{{view.index + 1}} / {{view.total}}步</view>
  <view class="replay-controls"><button class="secondary" disabled="{{loading || view.index === 0}}" data-step="0" bindtap="selectStep">第一步</button><button class="secondary" disabled="{{loading || view.index === 0}}" data-step="{{view.index - 1}}" bindtap="selectStep">上一条</button><button class="secondary" disabled="{{loading || view.index === view.total - 1}}" data-step="{{view.index + 1}}" bindtap="selectStep">下一条</button><button class="secondary" disabled="{{loading || view.index === view.total - 1}}" data-step="{{view.total - 1}}" bindtap="selectStep">最终结果</button></view>
  <view class="heading">{{view.phase}} · {{view.at}}</view><view wx:if="{{view.text}}" class="prose">{{view.text}}</view><view wx:if="{{view.text}}" class="small muted">原文发布 {{view.sourceAt}}</view>
  <view class="line"></view><view class="heading">按预告跟踪</view><view class="prose">当时状态：{{view.status}}</view><view wx:if="{{view.announced}}" class="prose">{{view.announced}}</view><view wx:if="{{view.resolved}}" class="prose">{{view.resolved}}</view><view class="prose muted">预告时间沿用原文。到时只标记等待确认；取得同轮、同类福利的明确后续声明后，才记录公开完成。个人账户到账未测。</view>
 </view>
 <view wx:if="{{view.announcement}}" class="card"><view class="heading">预告兑现核对</view><view class="prose">{{view.announcement}}</view><view wx:for="{{view.announcementCases}}" wx:key="id" class="prose"><view>{{item.title}}</view><view>{{item.expected}}</view><view>{{item.result}}</view></view></view>
 <view wx:if="{{view}}" class="card"><button class="secondary full" bindtap="toggleStatistics">{{showStatistics ? '收起' : '展开'}}历史间隔实验记录（独立统计）</button><view wx:if="{{showStatistics}}"><view class="prose muted">只使用以往公开动态的间隔，不采用本轮预告时间，不能作为预告解读或本轮兑现成绩。</view><view class="heading">{{view.probability}}</view><view wx:if="{{view.predictedAt}}" class="prose">估计时刻：{{view.predictedAt}}</view><view class="prose muted">{{view.explanation}}</view><view wx:if="{{view.scores}}"><view class="heading">统计估计的最终核对</view><view wx:if="{{view.noScores}}" class="prose muted">本批未产生可评分的统计估计，样本不足记录全部保留。</view><view wx:for="{{view.scores}}" wx:key="id" class="prose"><view>{{item.at}} 的首次估计</view><view>{{item.result}}</view><view class="small muted">区间宽度 {{item.width}}小时</view></view></view></view></view>
 <view wx:if="{{view}}" class="card"><view class="heading">资料边界</view><view wx:for="{{view.notes}}" wx:key="*this" class="prose muted">{{item}}</view><view class="prose muted">公开声明时间不代表个人账户实际到账时间。历史模拟不能证明系统过去一个月持续在线。</view></view>
</view>
