page{min-height:100%;background:#0b1113;color:#e9ede8;font-size:16px;line-height:1.65;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
view,text,button,scroll-view{box-sizing:border-box}button{margin:0;font-size:14px;font-weight:600;line-height:1.5;min-height:44px;padding:11px 15px;border-radius:9px;background:#131c1e;color:#e9ede8;display:flex;align-items:center;justify-content:center}button::after{border:0}button[disabled]{opacity:.45;color:#9aa6a6;background:#172022}
.page{min-height:100vh;background:#0b1113;padding:18px 20px 28px}.card{background:#101819;border:1px solid #303b3d;border-radius:11px;padding:18px;margin-bottom:14px}.hero{background:linear-gradient(145deg,#20261f,#101819);border-color:#53492f}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.wrap{flex-wrap:wrap}.top{align-items:flex-start}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:12px}.section{margin:24px 0 14px}.title{font-size:23px;font-weight:650;line-height:1.4;word-break:break-word}.heading{font-size:18px;font-weight:650;line-height:1.5}.brand{font-size:17px;font-weight:700;line-height:1.65}.hero-number{color:#f4c15c;font-size:38px;font-weight:650;line-height:1.25;margin:12px 0}.muted{color:#98a6a5}.small{font-size:12px}.cyan{color:#f4c15c}.purple{color:#c7c9b8}.badge{display:inline-block;font-size:11px;line-height:1.6;padding:3px 8px;border:1px solid #4c482e;border-radius:5px;background:#26271c;color:#ebc778}.badge.purple{background:#252920;border-color:#454d3e;color:#cdd4b9}.badge.muted{background:#192223;border-color:#344144;color:#abb6b3}.badge.amber{background:#332c1b;border-color:#5a4b2a;color:#f4c15c}.time{font-size:11px;color:#98a6a5}.prose{white-space:pre-wrap;word-break:break-word;margin-top:10px;font-size:14px;line-height:1.85}.lead{margin-top:8px}.line{border-top:1px solid #303b3d;margin:18px 0}.link{min-height:44px;display:flex;align-items:center;gap:8px;color:#f4c15c;font-weight:600;padding:8px 0}.primary{background:linear-gradient(115deg,#f8cf7b,#f3b847);border:1px solid #f4c15c;color:#171a17}.secondary{background:transparent;border:1px solid #44504e;color:#e4e9e3}.full{width:100%}.buttons{display:flex;gap:10px}.buttons button{flex:1;min-width:0}.warning{padding:14px;margin-bottom:14px;border:1px solid #655339;border-radius:9px;background:#28251a;color:#e7c887;font-size:13px;word-break:break-word}.foot{color:#8c9b99;font-size:11px;text-align:center;margin-top:22px;line-height:1.8}.empty{text-align:center;padding:30px 18px;color:#98a6a5}.empty .heading{color:#dfe6db;margin-bottom:8px}.chips{display:flex;gap:0;border-bottom:1px solid #303b3d;margin-bottom:18px}.chips button{flex:1;min-width:0;font-size:13px;min-height:46px;padding:10px 5px;font-weight:500;background:none;color:#98a6a5;border-radius:0;border-bottom:2px solid transparent}.chips .active{background:none;color:#f4c15c;border-bottom-color:#f4c15c}.setting-row{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid #303b3d;min-height:68px}.setting-row:last-child{border-bottom:0}switch{flex:none;padding:8px 0}.source-row{padding:14px 0;border-bottom:1px solid #303b3d}.source-row:last-child{border-bottom:0}.fact{padding:12px 0;border-bottom:1px solid #293335;font-size:14px}.fact:last-child{border-bottom:0}.fact .small{margin-bottom:3px}.quote{padding:12px 14px;margin:10px 0;border-left:2px solid #b29960;background:#0b1113;white-space:pre-wrap;word-break:break-word}.announcement-title{margin:12px 0 8px;font-size:18px;font-weight:650;line-height:1.5;word-break:break-word}.calendar-scroll{white-space:nowrap;width:100%;margin-top:16px}.weeks{display:inline-flex;gap:4px;padding-bottom:6px}.week{display:inline-flex;flex-direction:column;gap:4px;width:44px;vertical-align:top}.week-label{text-align:center;color:#98a6a5;font-size:12px;height:24px}.day{width:44px;height:44px;min-height:44px;padding:0;border:1px solid #384643;border-radius:7px;background:#101819;color:#a7b3ad;font-size:16px;font-weight:500}.day.cyan{background:#bb913e;color:#151a16}.day.purple{background:#788268;color:#fff}.day.both{background:linear-gradient(135deg,#bb913e 49%,#788268 51%);color:#fff}.day.pending{border:2px solid #d6bf87;background:#101819;color:#e4d7b7}.day.selected{border:2px solid #e9ede8}.day[disabled]{opacity:.35}.day-legend{gap:12px;justify-content:flex-start;flex-wrap:wrap;font-size:12px;color:#aab8b3}.recent-days{display:flex;justify-content:space-between;gap:2px;margin-top:12px;min-width:320px}.recent-days .day{flex:none}.dot{width:6px;height:6px;border-radius:50%;display:inline-block;background:#f4c15c}.dot.purple{background:#a9b298}.activity-days{display:flex;gap:7px;flex-wrap:wrap}.activity-day{min-width:44px;min-height:44px;padding:9px 11px;border:1px solid #384643;background:#101819;font-size:15px;position:relative}.activity-day.selected{border-color:#c2bd93;background:#353a29;color:#e7e5c8}.activity-day .dot{position:absolute;bottom:3px;width:4px;height:4px;background:#c2bd93}.notice-read{opacity:.75}.notice-unread{border-left:3px solid #f4c15c}.chevron{color:#f4c15c;font-size:20px}.source-text{white-space:pre-wrap;word-break:break-word;font-size:14px}.notice-empty{padding:24px 0}.plain-heading{margin-bottom:12px}.text-button{padding:0;min-height:44px;background:none;color:#f4c15c;font-size:12px;font-weight:500;border-radius:0;justify-content:flex-start}.text-button .chevron{margin-left:6px;font-size:16px}.row-button{background:none;padding:13px 0;border-bottom:1px solid #303b3d;justify-content:space-between;border-radius:0;width:100%;color:#f4c15c;font-size:14px;min-height:54px}.row-button:last-child{border-bottom:0}.listing-heading{margin-bottom:14px}.listing-heading .muted{font-size:12px}.disclosure-heading{width:100%;background:none;min-height:44px;padding:0;justify-content:space-between;font-size:16px;text-align:left}.disclosure-symbol{font-size:20px;color:#b5c0b9;margin-left:12px}.record-row{display:flex;align-items:flex-start;gap:14px;font-size:13px}.record-row .muted{width:66px;flex:none}.record-row>view:last-child{flex:1;min-width:0;word-break:break-word}.poster-themes{margin-top:12px}.poster-themes .active{color:#f4c15c;border-color:#b89a55;background:#2a281c}

.update-prompt{display:block;width:100%;margin:12px 0;padding:10px 14px;border:1px solid #685e46;border-radius:10px;color:#e4d3a9;background:#1b211e;font-size:14px}.schedule-actions{display:flex;justify-content:flex-end;margin:0 0 12px}.chips{min-height:44px}
