/* Silver neural UI. Fixed share poster artwork keeps its own two palettes. */
page{min-height:100%;background:#f2f5fb;color:#14263e;font-size:16px;line-height:1.65;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
view,text,button,scroll-view{box-sizing:border-box}button{margin:0;font-size:14px;font-weight:600;line-height:1.5;min-height:44px;padding:11px 15px;border-radius:9px;background:#e8eef8;color:#14263e;display:flex;align-items:center;justify-content:center}button::after{border:0}button[disabled]{opacity:.45;color:#4d607b;background:#e8eef8}
.page{min-height:0;background:#f2f5fb;padding:18px 20px 28px}.card{background:#ffffff;border:1px solid #ccd9ed;border-radius:11px;padding:18px;margin-bottom:14px}.hero{background:linear-gradient(145deg,#e8effa,#ffffff);border-color:#ccd9ed}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.wrap{flex-wrap:wrap}.top{align-items:flex-start}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:12px}.section{margin:24px 0 14px}.title{font-size:23px;font-weight:650;line-height:1.4;word-break:break-word}.heading{font-size:18px;font-weight:650;line-height:1.5}.brand{font-size:17px;font-weight:700;line-height:1.65}.hero-number{color:#2458ce;font-size:38px;font-weight:650;line-height:1.25;margin:12px 0}.muted{color:#4d607b}.small{font-size:12px}.cyan{color:#2458ce}.purple{color:#624b9a}.badge{display:inline-block;font-size:11px;line-height:1.6;padding:3px 8px;border:1px solid #b6cbec;border-radius:5px;background:#d9e6fb;color:#2458ce}.badge.purple{background:#ece6f7;border-color:#d8cfee;color:#624b9a}.badge.muted{background:#e8eef8;border-color:#ccd9ed;color:#4d607b}.badge.amber{background:#f4ead6;border-color:#ddcba9;color:#2458ce}.time{font-size:11px;color:#4d607b}.prose{white-space:pre-wrap;word-break:break-word;margin-top:10px;font-size:14px;line-height:1.85}.lead{margin-top:8px}.line{border-top:1px solid #ccd9ed;margin:18px 0}.link{min-height:44px;display:flex;align-items:center;gap:8px;color:#2458ce;font-weight:600;padding:8px 0}.primary{background:linear-gradient(115deg,#1d45a3,#2458ce);border:1px solid #2458ce;color:#ffffff}.secondary{background:transparent;border:1px solid #91aaca;color:#14263e}.full{width:100%}.buttons{display:flex;gap:10px}.buttons button{flex:1;min-width:0}.warning{padding:14px;margin-bottom:14px;border:1px solid #ddcba9;border-radius:9px;background:#f4ead6;color:#765422;font-size:13px;word-break:break-word}.foot{color:#4d607b;font-size:11px;text-align:center;margin-top:22px;line-height:1.8}.empty{text-align:center;padding:30px 18px;color:#4d607b}.empty .heading{color:#14263e;margin-bottom:8px}.chips{display:flex;gap:0;border-bottom:1px solid #ccd9ed;margin-bottom:18px}.chips button{flex:1;min-width:0;font-size:13px;min-height:46px;padding:10px 5px;font-weight:500;background:none;color:#4d607b;border-radius:0;border-bottom:2px solid transparent}.chips .active{background:none;color:#2458ce;border-bottom-color:#2458ce}.setting-row{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid #ccd9ed;min-height:68px}.setting-row:last-child{border-bottom:0}switch{flex:none;padding:8px 0}.source-row{padding:14px 0;border-bottom:1px solid #ccd9ed}.source-row:last-child{border-bottom:0}.fact{padding:12px 0;border-bottom:1px solid #ccd9ed;font-size:14px}.fact:last-child{border-bottom:0}.fact .small{margin-bottom:3px}.quote{padding:12px 14px;margin:10px 0;border-left:2px solid #2458ce;background:#f2f5fb;white-space:pre-wrap;word-break:break-word}.announcement-title{margin:12px 0 8px;font-size:18px;font-weight:650;line-height:1.5;word-break:break-word}.calendar-scroll{white-space:nowrap;width:100%;margin-top:16px}.weeks{display:inline-flex;gap:4px;padding-bottom:6px}.week{display:inline-flex;flex-direction:column;gap:4px;width:44px;vertical-align:top}.week-label{text-align:center;color:#4d607b;font-size:12px;height:24px}.day{width:44px;height:44px;min-height:44px;padding:0;border:1px solid #ccd9ed;border-radius:7px;background:#ffffff;color:#4d607b;font-size:16px;font-weight:500}.day.cyan{background:#2458ce;color:#ffffff}.day.purple{background:#624b9a;color:#fff}.day.both{background:linear-gradient(135deg,#2458ce 49%,#624b9a 51%);color:#fff}.day.pending{border:2px solid #91aaca;background:#ffffff;color:#355a86}.day.selected{border:2px solid #14263e}.day[disabled]{opacity:.35}.day-legend{gap:12px;justify-content:flex-start;flex-wrap:wrap;font-size:12px;color:#4d607b}.recent-days{display:flex;justify-content:space-between;gap:2px;margin-top:12px;min-width:320px}.recent-days .day{flex:none}.dot{width:6px;height:6px;border-radius:50%;display:inline-block;background:#2458ce}.dot.purple{background:#624b9a}.activity-days{display:flex;gap:7px;flex-wrap:wrap}.activity-day{min-width:44px;min-height:44px;padding:9px 11px;border:1px solid #ccd9ed;background:#ffffff;font-size:15px;position:relative}.activity-day.selected{border-color:#2458ce;background:#d9e6fb;color:#2458ce}.activity-day .dot{position:absolute;bottom:3px;width:4px;height:4px;background:#2458ce}.notice-read{opacity:1}.notice-unread{border-left:3px solid #2458ce}.chevron{color:#2458ce;font-size:20px}.source-text{white-space:pre-wrap;word-break:break-word;font-size:14px}.notice-empty{padding:24px 0}.plain-heading{margin-bottom:12px}.text-button{padding:0;min-height:44px;background:none;color:#2458ce;font-size:12px;font-weight:500;border-radius:0;justify-content:flex-start}.text-button .chevron{margin-left:6px;font-size:16px}.row-button{background:none;padding:13px 0;border-bottom:1px solid #ccd9ed;justify-content:space-between;border-radius:0;width:100%;color:#2458ce;font-size:14px;min-height:54px}.row-button:last-child{border-bottom:0}.listing-heading{margin-bottom:14px}.listing-heading .muted{font-size:12px}.disclosure-heading{width:100%;background:none;min-height:44px;padding:0;justify-content:space-between;font-size:16px;text-align:left}.disclosure-symbol{font-size:20px;color:#4d607b;margin-left:12px}.record-row{display:flex;align-items:flex-start;gap:14px;font-size:13px}.record-row .muted{width:66px;flex:none}.record-row>view:last-child{flex:1;min-width:0;word-break:break-word}.poster-themes{margin-top:12px}.poster-themes .active{color:#2458ce;border-color:#2458ce;background:#d9e6fb}

.update-prompt{display:block;width:100%;margin:12px 0;padding:10px 14px;border:1px solid #b6cbec;border-radius:10px;color:#2458ce;background:#e8effa;font-size:14px}.schedule-actions{display:flex;justify-content:flex-end;margin:0 0 12px}.chips{min-height:44px}

@media(prefers-reduced-motion:reduce){button{transition:none}}
