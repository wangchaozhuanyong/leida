/* Silver neural UI. Fixed share poster artwork keeps its own two palettes. */
page{min-height:100%;background:#f2f5fb;color:#14263e;font-size:15px;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
view,text,button,scroll-view{box-sizing:border-box}button{margin:0;font-size:14px;font-weight:500;line-height:1.5714;min-height:44px;padding:11px 15px;border-radius:8px;background:#e8eef8;color:#14263e;display:flex;align-items:center;justify-content:center}button::after{border:0}button[disabled]{opacity:.45;color:#4d607b;background:#e8eef8}
.page{min-height:0;background:#f2f5fb;position:relative;padding:12px 16px 32px}.card{background:#ffffff;border:1px solid #dce5f1;border-radius:16px;padding:16px;margin-bottom:12px}.hero{background:linear-gradient(145deg,#e8effa,#ffffff);border-color:#dce5f1}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.wrap{flex-wrap:wrap}.top{align-items:flex-start}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:12px}.section{margin:24px 0 12px}.title{font-size:22px;font-weight:600;line-height:1.3636;word-break:break-word}.heading{font-size:17px;font-weight:600;line-height:1.4118}.brand{font-size:17px;font-weight:700;line-height:1.65}.hero-number{color:#2458ce;font-size:40px;font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums;margin:12px 0}.muted{color:#4d607b}.small{font-size:12px}.cyan{color:#2458ce}.purple{color:#624b9a}.badge{display:inline-block;font-size:11px;line-height:1.6;padding:3px 8px;border:1px solid #b6cbec;border-radius:8px;background:#d9e6fb;color:#2458ce}.badge.purple{background:#ece6f7;border-color:#d8cfee;color:#624b9a}.badge.muted{background:#e8eef8;border-color:#dce5f1;color:#4d607b}.badge.amber{background:#f4ead6;border-color:#ddcba9;color:#2458ce}.time{font-size:11px;color:#4d607b}.prose{white-space:pre-wrap;word-break:break-word;margin-top:10px;font-size:15px;line-height:1.6}.lead{margin-top:8px}.line{border-top:1px solid #dce5f1;margin:16px 0}.link{min-height:44px;display:flex;align-items:center;gap:8px;color:#2458ce;font-weight:600;padding:8px 0}.primary{background:linear-gradient(115deg,#1d45a3,#2458ce);border:1px solid #2458ce;color:#ffffff}.secondary{background:transparent;border:1px solid #91aaca;color:#14263e}.full{width:100%}.buttons{display:flex;gap:8px}.buttons button{flex:1;min-width:0}.warning{padding:14px;margin-bottom:14px;border:1px solid #ddcba9;border-radius:8px;background:#f4ead6;color:#765422;font-size:12px;line-height:1.5;word-break:break-word}.foot{color:#4d607b;font-size:11px;text-align:center;margin-top:22px;line-height:1.8}.empty{text-align:center;padding:30px 18px;color:#4d607b}.empty .heading{color:#14263e;margin-bottom:8px}.chips button{flex:1;min-width:0;font-size:13px;min-height:46px;padding:10px 5px;font-weight:500;background:none;color:#4d607b;border-radius:0;border-bottom:2px solid transparent}.chips .active{background:none;color:#2458ce;border-bottom-color:#2458ce}.setting-row{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:16px 0;border-bottom:1px solid #dce5f1;min-height:56px}.setting-row:last-child{border-bottom:0}switch{flex:none;padding:8px 0}.source-row{padding:14px 0;border-bottom:1px solid #dce5f1}.source-row:last-child{border-bottom:0}.fact{padding:12px 0;border-bottom:1px solid #dce5f1;font-size:14px}.fact:last-child{border-bottom:0}.fact .small{margin-bottom:3px}.quote{padding:12px 14px;margin:10px 0;border-left:2px solid #2458ce;background:#f2f5fb;white-space:pre-wrap;word-break:break-word}.announcement-title{margin:12px 0 8px;font-size:17px;font-weight:600;line-height:1.4118;word-break:break-word}.calendar-scroll{white-space:nowrap;width:100%;margin-top:16px}.weeks{display:inline-flex;gap:4px;padding-bottom:6px}.week{display:inline-flex;flex-direction:column;gap:4px;width:44px;vertical-align:top}.week-label{text-align:center;color:#4d607b;font-size:12px;height:24px}.day{width:44px;height:44px;min-height:44px;padding:0;border:1px solid #dce5f1;border-radius:8px;background:#ffffff;color:#4d607b;font-size:16px;font-weight:500}.day.cyan{background:#2458ce;color:#ffffff}.day.purple{background:#624b9a;color:#fff}.day.both{background:linear-gradient(135deg,#2458ce 49%,#624b9a 51%);color:#fff}.day.pending{border:2px solid #91aaca;background:#ffffff;color:#355a86}.day.selected{border:2px solid #14263e}.day[disabled]{opacity:.35}.day-legend{gap:12px;justify-content:flex-start;flex-wrap:wrap;font-size:12px;color:#4d607b}.recent-days{display:flex;justify-content:space-between;gap:2px;margin-top:12px;min-width:0;flex-wrap:wrap}.recent-days .day{flex:none}.dot{width:6px;height:6px;border-radius:50%;display:inline-block;background:#2458ce}.dot.purple{background:#624b9a}.activity-days{display:flex;gap:7px;flex-wrap:wrap}.activity-day{min-width:44px;min-height:44px;padding:9px 11px;border:1px solid #dce5f1;background:#ffffff;font-size:15px;position:relative}.activity-day.selected{border-color:#2458ce;background:#d9e6fb;color:#2458ce}.activity-day .dot{position:absolute;bottom:3px;width:4px;height:4px;background:#2458ce}.notice-read{opacity:1}.notice-unread{border-left:3px solid #2458ce}.chevron{color:#2458ce;font-size:20px}.source-text{white-space:pre-wrap;word-break:break-word;font-size:15px;line-height:1.6}.notice-empty{padding:24px 0}.plain-heading{margin-bottom:12px}.text-button{padding:0;min-height:44px;background:none;color:#2458ce;font-size:12px;font-weight:500;border-radius:0;justify-content:flex-start}.text-button .chevron{margin-left:6px;font-size:16px}.row-button{background:none;padding:13px 0;border-bottom:1px solid #dce5f1;justify-content:space-between;border-radius:0;width:100%;color:#2458ce;font-size:14px;min-height:54px}.row-button:last-child{border-bottom:0}.listing-heading{margin-bottom:12px}.listing-heading .muted{font-size:12px}.disclosure-heading{width:100%;background:none;min-height:44px;padding:0;justify-content:space-between;font-size:17px;text-align:left}.disclosure-symbol{font-size:20px;color:#4d607b;margin-left:12px}.record-row{display:flex;align-items:flex-start;gap:14px;font-size:13px}.record-row .muted{width:66px;flex:none}.record-row>view:last-child{flex:1;min-width:0;word-break:break-word}.poster-themes{margin-top:12px}.poster-themes .active{color:#2458ce;border-color:#2458ce;background:#d9e6fb}

.update-prompt{display:block;width:100%;margin:12px 0;padding:10px 14px;border:1px solid #b6cbec;border-radius:8px;color:#2458ce;background:#e8effa;font-size:14px}.schedule-actions{display:flex;justify-content:flex-end;margin:0 0 12px}.chips{display:flex;gap:0;border-bottom:1px solid #dce5f1;margin-bottom:18px;min-height:44px}

@media(prefers-reduced-motion:reduce){button{transition:none}}

/* Refresh feedback is owned by navigation-header on every live page. */
/* Shared top-to-bottom entry: first content within 600ms, retained return within 300ms.
   Prepare retained content only while hidden; requests and gestures keep their own lifecycle. */
.content-primed>view:not(.motion-static):not(.motion-container),.content-primed>publication-card,.content-primed>button,.content-primed .motion-step{opacity:0;transform:translateY(-8px)}
.content-enter>view:not(.motion-static):not(.motion-container),.content-enter>publication-card,.content-enter>button,.content-enter .motion-step,.settled-reveal{animation:content-arrive .32s cubic-bezier(.22,.8,.24,1) both}
.content-return>view:not(.motion-static):not(.motion-container),.content-return>publication-card,.content-return>button,.content-return .motion-step{animation:content-return-arrive .18s cubic-bezier(.22,.8,.24,1) both}
.content-enter>view:nth-child(2),.content-enter>publication-card:nth-child(2),.content-enter>button:nth-child(2){animation-delay:0.04s}
.content-enter>view:nth-child(3),.content-enter>publication-card:nth-child(3),.content-enter>button:nth-child(3){animation-delay:0.08s}
.content-enter>view:nth-child(4),.content-enter>publication-card:nth-child(4),.content-enter>button:nth-child(4){animation-delay:0.12s}
.content-enter>view:nth-child(5),.content-enter>publication-card:nth-child(5),.content-enter>button:nth-child(5){animation-delay:0.16s}
.content-enter>view:nth-child(6),.content-enter>publication-card:nth-child(6),.content-enter>button:nth-child(6){animation-delay:0.20s}
.content-enter>view:nth-child(7),.content-enter>publication-card:nth-child(7),.content-enter>button:nth-child(7){animation-delay:0.24s}
.content-enter>view:nth-child(n+8),.content-enter>publication-card:nth-child(n+8),.content-enter>button:nth-child(n+8){animation-delay:0.28s}
.content-enter .motion-step-0{animation-delay:0.00s}
.content-enter .motion-step-1{animation-delay:0.04s}
.content-enter .motion-step-2{animation-delay:0.08s}
.content-enter .motion-step-3{animation-delay:0.12s}
.content-return>view:nth-child(2),.content-return>publication-card:nth-child(2),.content-return>button:nth-child(2){animation-delay:0.02s}
.content-return>view:nth-child(3),.content-return>publication-card:nth-child(3),.content-return>button:nth-child(3){animation-delay:0.04s}
.content-return>view:nth-child(4),.content-return>publication-card:nth-child(4),.content-return>button:nth-child(4){animation-delay:0.06s}
.content-return>view:nth-child(5),.content-return>publication-card:nth-child(5),.content-return>button:nth-child(5){animation-delay:0.08s}
.content-return>view:nth-child(6),.content-return>publication-card:nth-child(6),.content-return>button:nth-child(6){animation-delay:0.10s}
.content-return>view:nth-child(7),.content-return>publication-card:nth-child(7),.content-return>button:nth-child(7){animation-delay:0.12s}
.content-return>view:nth-child(n+8),.content-return>publication-card:nth-child(n+8),.content-return>button:nth-child(n+8){animation-delay:0.12s}
.content-return .motion-step-0{animation-delay:0.00s}
.content-return .motion-step-1{animation-delay:0.02s}
.content-return .motion-step-2{animation-delay:0.04s}
.content-return .motion-step-3{animation-delay:0.06s}
@keyframes content-arrive{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
@keyframes content-return-arrive{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.content-primed>view,.content-primed>publication-card,.content-primed>button,.content-enter>view,.content-enter>publication-card,.content-enter>button,.content-return>view,.content-return>publication-card,.content-return>button,.content-primed .motion-step,.content-enter .motion-step,.content-return .motion-step,.settled-reveal{animation:none!important;transform:none!important;opacity:1!important}}


/* Shared page rhythm; safe-area height belongs exclusively to navigation-header. */
.card>.heading+.lead,.card>.heading+.muted{margin-top:8px}


/* A temporary cache notice never inserts a row or moves the reading position. */
.cached-content-note{position:fixed;z-index:20;left:16px;right:16px;bottom:calc(74px + env(safe-area-inset-bottom));width:max-content;max-width:calc(100% - 32px);margin:0 auto;padding:8px 12px;border:1px solid #dce5f1;border-radius:8px;background:rgba(242,245,251,.96);color:#4d607b;font-size:12px;line-height:18px;text-align:center;pointer-events:none}
