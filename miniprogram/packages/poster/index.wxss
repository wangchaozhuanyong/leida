.poster-page{padding:14px 20px 24px}.poster-style-options{display:flex;gap:10px;margin-bottom:14px}.poster-style-options button{flex:1;min-width:0;background:#ffffff;border:1px solid #ccd9ed;font-size:13px;gap:8px;min-height:46px}.poster-style-options .selected{border-color:#2458ce;color:#2458ce;background:#d9e6fb}.style-dot{width:14px;height:18px;border:1px solid #a19265;border-radius:2px;flex:none}.style-dot.dark{background:#101311}.style-dot.light{background:#f1e6d1}.poster-stage{width:100%;border-radius:8px;overflow:hidden}.poster-stage-empty{min-height:300px;display:flex;align-items:center;justify-content:center;background:#e8eef8}.poster-image{display:block;width:100%}.poster-message{padding:24px;text-align:center;color:#4d607b;font-size:14px}.poster-actions{margin-top:16px}.poster-actions button{min-height:48px}.poster-note{margin-top:10px;line-height:1.65}

.poster-stage{position:relative}.poster-busy{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#f2f5fbe8}
