.poster-page{padding:12px 16px 32px}.poster-style-options{display:flex;gap:8px;margin-bottom:12px}.poster-style-options button{flex:1;min-width:0;background:#ffffff;border:1px solid #dce5f1;gap:8px;min-height:46px;font-size:14px;border-radius:8px}.poster-style-options .selected{border-color:#2458ce;color:#2458ce;background:#d9e6fb}.style-dot{width:14px;height:18px;border:1px solid #a19265;border-radius:2px;flex:none}.style-dot.dark{background:#101311}.style-dot.light{background:#f1e6d1}.poster-stage-empty{min-height:300px;display:flex;align-items:center;justify-content:center;background:#e8eef8}.poster-image{display:block;width:100%}.poster-message{padding:24px;text-align:center;color:#4d607b;font-size:15px;line-height:24px}.poster-actions{margin-top:16px}.poster-actions button{min-height:48px}.poster-note{margin-top:10px;font-size:12px;line-height:18px}

.poster-stage{width:100%;overflow:hidden;border-radius:16px;position:relative;border-radius:16px}.poster-busy{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#f2f5fbe8}
.poster-has-preview .poster-busy{inset:auto 12px 12px;border-radius:8px;padding:10px 14px;font-size:12px;background:#f2f5fbef;min-height:0}
