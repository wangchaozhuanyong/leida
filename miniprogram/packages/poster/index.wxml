<navigation-header title="分享海报" back="{{true}}" />
<page-loader wx:if="{{navigationLoading}}" />
<view wx:else class="page poster-page" bindtouchstart="nativeReturnTouched">
  <status-panel wx:if="{{!connected}}" loading="{{loading}}" error="{{error}}" unconfigured="{{unconfigured}}" bindretry="retry" />
  <block wx:else><view class="poster-style-options"><button class="{{theme==='precision'?'selected':''}}" data-theme="precision" bindtap="selectTheme"><view class="style-dot dark"></view>黑金仪表</button><button class="{{theme==='editorial'?'selected':''}}" data-theme="editorial" bindtap="selectTheme"><view class="style-dot light"></view>水墨刊物</button></view>
    <view class="poster-stage {{!preview ? 'poster-stage-empty' : ''}}"><image wx:if="{{preview}}" src="{{preview}}" mode="widthFix" class="poster-image" bindtap="previewImage" aria-label="分享海报，点击查看大图"/><view wx:if="{{posterBusy}}" class="poster-message poster-busy" role="status">正在生成海报</view><view wx:elif="{{!preview}}" class="poster-message">{{blocked || posterError || '海报暂不可用'}}</view></view>
    <view wx:if="{{posterError && preview}}" class="warning">{{posterError}}</view><view wx:if="{{codeNote}}" class="small muted poster-note">{{codeNote}}</view>
    <button wx:if="{{posterError && !blocked}}" class="secondary full" bindtap="generate">重新生成</button>
    <view class="buttons poster-actions"><button class="secondary" open-type="share" disabled="{{!!blocked}}">分享小程序</button><button class="primary" bindtap="save" loading="{{posterSaving}}" disabled="{{!preview || posterBusy || posterSaving || !!blocked}}">保存海报</button></view>
    <view wx:if="{{privacyNeeded}}" class="card stack"><button class="secondary" bindtap="openPrivacyContract">查看隐私指引</button><button class="primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="save">同意并保存</button></view><view class="small muted poster-note">海报内容自动生成，所有时间均为北京时间。</view>
  </block>
</view>
<canvas type="2d" id="status-poster-canvas" style="position:fixed;left:-9999px;top:0;width:1080px;height:1920px"/>
