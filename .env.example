DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
POSTGRES_PASSWORD=replace-with-your-database-password
BETTER_AUTH_SECRET=replace-with-a-long-random-auth-secret
BETTER_AUTH_URL=https://YOUR_CLOUDRUN_DOMAIN
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

# 仅 scripts/test-cloudbase-live.ts 的隔离验证使用，不会切换网站或 worker。
# 由用户在 .env.cloudbase-validation.local 填写；服务端密钥不发送到聊天。
CLOUDBASE_TEST_ENV_ID=replace-with-leida-test-environment-id
CLOUDBASE_TEST_API_KEY=replace-with-backend-only-api-key

# 完整 CloudBase 候选支持公共读取、业务写入、管理认证、初始化及 AI 账本；默认 native。
# cloudbase 写入必须配套 cloudbase 公共读取，禁止分流到不同数据库。
# 全部受控接口安装后，完整 cloudbase 模式无需 DATABASE_URL；认证与加密配置仍必需。
RADAR_STORAGE_BACKEND=native
RADAR_PUBLIC_READ_BACKEND=native
CLOUDBASE_ENV_ID=replace-with-cloudbase-environment-id
CLOUDBASE_API_KEY=replace-with-backend-only-api-key

# 可选隔离验收输出：仅测试命令使用，不影响网站配置；保留既有报告。
# RADAR_RULE_REPORT=history-repair-rules-<日期>-<批次>.json
# RADAR_REPLAY_REPORT=history-repair-worker-<日期>-<批次>.json
# RADAR_FORECAST_HTTP_REPORT=forecast-http-qa-<日期>-<批次>.json
